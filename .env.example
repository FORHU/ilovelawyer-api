PORT=
POSTGRES_PORT=
DATABASE_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_COMMANDER_PORT=
REDIS_PASSWORD=
SECRET_KEY=

# Mailer (nodemailer SMTP transport). Use Ethereal (ethereal.email) for local
# dev/testing; production values are set via GitHub Actions secrets.
MAILER_TRANSPORT_HOST=
MAILER_TRANSPORT_PORT=
MAILER_TRANSPORT_SECURE=
MAILER_EMAIL=
MAILER_PASSWORD=
MAILER_FROM=

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY_DAYS=30d
SERVICE_ACCOUNT=
CLIENT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CHAT_WONDER_API_URL=
CHAT_WONDER_WS_URL=
CHAT_WONDER_API_KEY=
JURIS_PH_API_URL=
UK_CASELAW_BASE_URL=
UK_LEGISLATION_BASE_URL=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
CLOUDFRONT_URL=
# Signs/verifies the /files/<token> proxy links returned in place of raw presigned S3 URLs
# (see getProxyFileUrl in src/utils/s3.ts). Any random secret; e.g. `openssl rand -base64 32`.
FILE_TOKEN_SECRET=

# Local dev: run `docker compose up -d` (starts a per-developer LocalStack SQS emulator among
# other infra) and leave AWS_SQS_ENDPOINT + the 7 queue URLs below exactly as they are — every
# developer uses these same values, unmodified, because each developer's LocalStack instance is
# private to their own machine. There is no shared AWS resource in dev at all: a message this
# process sends can only ever be received by this same machine's workers (see
# src/lib/sqs.ts, which is the only client redirected by AWS_SQS_ENDPOINT — S3/Textract/Polly
# still use your real AWS_ACCESS_KEY/AWS_SECRET_ACCESS_KEY/AWS_REGION above against real AWS).
#
# To test against real AWS SQS instead (e.g. before a deploy): comment out AWS_SQS_ENDPOINT and
# point the 7 URLs at real, per-developer-named queues you created yourself (standard, not
# FIFO) — e.g. "document-extraction-dev-<yourname>". Never point two developers' .env files (or
# a dev .env and production) at the same real queue: each queue's consumer has no way to tell
# "not my message type" from "malformed" and will silently steal/drop the other's jobs.
AWS_SQS_ENDPOINT=http://localhost:4566
DOCUMENT_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/document-extraction
CITATION_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/citation-extraction
AUDIO_OVERVIEW_QUEUE_URL=http://localhost:4566/000000000000/audio-overview
CASE_RECONSTRUCTION_AUDIO_QUEUE_URL=http://localhost:4566/000000000000/case-reconstruction-audio
AI_GENERATION_QUEUE_URL=http://localhost:4566/000000000000/ai-generation
# Chat generation's full AI lifecycle (RAG/AI/persistence) — see chat-generation.queue.ts.
MESSAGE_PERSISTENCE_QUEUE_URL=http://localhost:4566/000000000000/message-persistence
# Case-graph enrichment (timeline/decision-record promotion) — see case-graph-promotion.queue.ts.
CASE_GRAPH_PROMOTION_QUEUE_URL=http://localhost:4566/000000000000/case-graph-promotion

# Used to embed Case Document chunks (text-embedding-3-small, vector(1536) — see
# CaseDocumentChunk in schema.prisma). Without this, document extraction always fails.
OPENAI_API_KEY=

# Local cheap profile. Uncomment for day-to-day testing. Official Brackenmoor
# scorecards should keep BENCHMARK_GRADER_MODEL=gpt-5.6-terra and
# CASE_FULL_TEXT_INLINE_CHARS=200000 (or unset, which is the code default).
# OMIT_EMBEDDING_RANKING is benchmark-only — leave unset for everyday chat.
# BENCHMARK_GRADER_MODEL=gpt-5.6-luna
# CASE_FULL_TEXT_INLINE_CHARS=40000
# OMIT_EMBEDDING_RANKING=true

# First admin account, created by prisma/seed.ts (runs automatically after
# `prisma migrate reset`, or on demand via `npm run prisma:seed`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# TypeSafe AI (Jev) — pilot for citation-proposition.ts and citation-validity.ts.
# USE_JEV_PROPOSITION=true routes citation-proposition classification through Jev instead of
# chat-wonder. USE_JEV_VALIDITY=true asks Jev to double-check the ambiguous case in
# evaluateCitation (quote/official text present, no textual match) instead of defaulting to
# INVALID. Both unset/false keep the original heuristic/chat-wonder paths.
TYPESAFE_API_KEY=
USE_JEV_PROPOSITION=
USE_JEV_VALIDITY=
# USE_JEV_MESSAGE_TRIAGE=true classifies every incoming consultation/case chat message in one Jev
# call for (a) urgency, (b) intent — CONSULTATION / DRAFT_DOCUMENT / DRAFT_PLEADING /
# ANALYZE_DOCUMENT / LEGAL_RESEARCH / PARALEGAL_TASK / DEADLINE_COMPUTATION / REVISE_PREVIOUS /
# OTHER — and (c) whether the message depends on an attached document (see message-triage.ts). All
# are persisted on the Message (urgent, urgencyProbability, intent, intentConfidence,
# refersToAttachment); urgency is
# mirrored to Consultation.urgentAt for the list badge, pushed as a chat:triage socket event, and
# above URGENCY_NOTIFY_THRESHOLD raises a CASE_UPDATE notification for the other participants. In
# chat-wonder's document_context an urgent turn gets a structured "act today" instruction and a
# confidently-classified document/pleading/analysis/paralegal/deadline/revision request gets a short
# steer toward producing that artefact instead of describing it. A message that refers to a document
# when nothing is attached or grounded gets a guard telling chat-wonder to say so rather than guess.
USE_JEV_MESSAGE_TRIAGE=
# USE_JEV_REDTEAM=true has Jev re-rate each ranked Red Team argument against the case data it
# cites — does the cited item support it, how likely a court accepts it, how much of the case it
# disposes of — and the panel's STRONG/MODERATE/WEAK label and impact number are computed from
# those instead of being the author model's self-rating (see red-team-jev.ts). Run
# scripts/jev-red-team-benchmark.ts against lawyer-labelled arguments before turning it on.
USE_JEV_REDTEAM=
# USE_JEV_AUTHORITY=true has Jev give a second opinion (Statute / On point / Adverse) on each
# authority added to the Law & Precedent panel, given the case ground and the resolved law text
# (see authority-stance-jev.ts). Never changes the lawyer's tag; the row only offers it when Jev
# disagrees with confidence >= 70%.
USE_JEV_AUTHORITY=
# USE_JEV_CONTRADICTIONS=true has Jev classify each newly scanned contradiction as DIRECT (both
# passages state incompatible values), INFERENTIAL (the conflict only follows by implication) or
# NOT_A_CONFLICT, shown as the Contradictions panel's severity tag instead of the banded scan
# confidence (see contradiction-nature-jev.ts). Run scripts/jev-contradiction-benchmark.ts
# against lawyer-labelled contradictions before turning it on.
USE_JEV_CONTRADICTIONS=
# USE_JEV_MINDMAP=true has Jev check each point on a case's document-built mind map against the
# page it cites — SUPPORTED / UNSUPPORTED / CONTRADICTED plus the kind of evidence (see
# mind-map-jev.ts) — after every build and on the new points of an expand, shown on the node.
# Run scripts/jev-mind-map-benchmark.ts against lawyer-labelled nodes before turning it on.
USE_JEV_MINDMAP=
# USE_FULL_CONTRADICTION_SCAN=true also scans every chunk of every document for contradictions,
# not just the ~32-chunk sample the Chat Wonder scan reads: every date/amount/duration is
# extracted with its exhibit and page, pairs whose passages are about the same thing are
# proposed, and Jev keeps only the ones it reads as DIRECT or INFERENTIAL conflicts (see
# full-contradiction-scan.service.ts). Needs TYPESAFE_API_KEY. Run
# scripts/full-contradiction-scan-benchmark.ts against the Brackenmoor bundle first.
USE_FULL_CONTRADICTION_SCAN=

# USE_GROUNDING_VERIFIER=true checks each legal answer on a CASE-linked consultation against that
# case's bundle after the answer is persisted, and writes AnswerGroundingCheck rows — see
# docs/plans/grounding-verifier.md. Two checks: (a) claims the answer makes that material was
# unavailable to it, classified FALSE_ABSENCE (we sent the text and it said we didn't) /
# NOT_SUPPLIED (in the case, but never sent — a pipeline gap, not a model error) / CORRECT_ABSENCE,
# decided by lookup with no AI cost; (b) each cited assertion, judged by Jev as SUPPORTED /
# UNSUPPORTED / CONTRADICTED. Needs TYPESAFE_API_KEY for (b). Never blocks or delays a reply: it
# runs after chat:done and swallows its own failures. Unset/false: no scan at all.
USE_GROUNDING_VERIFIER=
# Assertions checked per answer, most-cited first (default 40). A Brackenmoor-sized answer carries
# 85–276 citations; verifying every one would cost more than the turn did.
GROUNDING_MAX_ASSERTIONS=
