generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/legal-rag-client"
}

datasource db {
  provider = "postgresql"
  url      = env("LEGAL_RAG_DATABASE_URL")
}

model Document {
  id                 BigInt    @id
  source_hash        String?
  content_hash       String?
  bucket_slug        String?
  category           String?
  subcategory        String?
  title              String?
  case_no            String?
  year               Int?
  source_url         String?
  metadata_json      Json?
  summary            String?
  concise_summary    String?
  full_text          String?
  full_text_source   String?
  s3_json_path       String?
  s3_manifest_path   String?
  created_at         DateTime? @db.Timestamptz()
  updated_at         DateTime? @db.Timestamptz()
  formatted_markdown String?

  @@map("documents")
}
