model EvidenceContradiction {
  id               String               @id @default(uuid())
  caseId           String
  kind             String
  leftDocumentId   String
  rightDocumentId  String
  leftExcerpt      String               @db.Text
  rightExcerpt     String               @db.Text
  factKey          String
  leftValue        String
  rightValue       String
  confidence       Float                @default(0.5)
  // Lawyer's triage. Every scan rebuilds this table (EvidenceRepo.replaceContradictions), so these
  // and the Jev fields below are carried over to the re-found row with the same fingerprint (see
  // contradictionKey) — a resolved contradiction stays resolved across rescans.
  status           ContradictionStatus  @default(OPEN)
  resolutionNote   String?              @db.Text
  resolvedAt       DateTime?
  resolvedById     String?
  // Jev's read of the two passages (USE_JEV_CONTRADICTIONS) — null when the flag was off at scan
  // time or the call failed; the panel then falls back to banding `confidence`.
  nature           ContradictionNature?
  natureConfidence Float?
  // Where in the document each side sits (e.g. "D13 p.2") — set by the full-bundle scan, which
  // often pairs two exhibits inside one merged PDF, so the document name alone can't tell them apart.
  leftLocator      String?
  rightLocator     String?
  createdAt        DateTime             @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

enum MissingEvidenceSeverity {
  CRITICAL
  MODERATE
  MINOR
}

enum MissingEvidenceStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// What the case's own documents don't yet establish — one row per gap, rather than the prose
/// list CaseReconstruction.gaps holds (a flat String[] tied to nothing). The lawyer's triage
/// fields mirror EvidenceContradiction's. A regeneration replaces AI rows (notes ===
/// AI_MISSING_EVIDENCE_NOTE) but leaves a lawyer-edited one (lawyerEditedAt) alone, matched by
/// label — see MissingEvidenceRepo.replaceAiItems.
model CaseMissingEvidence {
  id     String @id @default(uuid())
  caseId String
  // The claim this gap would support, as a plain id — not a relation, so re-extracting the
  // case's claims never orphans or blocks a row. Null for a gap that isn't tied to one claim.
  claimId         String?
  label           String
  detail          String?                 @db.Text
  suggestedSource String?                 @db.Text
  severity        MissingEvidenceSeverity
  status          MissingEvidenceStatus   @default(OPEN)
  resolutionNote  String?                 @db.Text
  resolvedAt      DateTime?
  resolvedById    String?
  notes           String?
  lawyerEditedAt  DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([claimId])
}

/// Jev's verdict on one candidate pair from the full-bundle contradiction scan
/// (full-contradiction-scan.service.ts), cached so a rescan never pays to re-check a pair —
/// including the NOT_A_CONFLICT ones, which never become EvidenceContradiction rows.
model FactPairCheck {
  id         String              @id @default(uuid())
  caseId     String
  pairKey    String
  nature     ContradictionNature
  confidence Float
  checkedAt  DateTime            @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, pairKey])
}

enum ContradictionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ContradictionNature {
  DIRECT
  INFERENTIAL
  NOT_A_CONFLICT
}

enum OfficialTextSource {
  LAWYER
  PH_LAW
  UK_LEGISLATION
  UK_JUDGMENT
}

model CitationCheck {
  id             String                 @id @default(uuid())
  caseId         String
  quotedText     String                 @db.Text
  citedReference String?
  sourceUrl      String?
  officialText   String?                @db.Text
  // Where officialText came from (#364): pasted by the lawyer, or fetched from the authority the
  // citation resolved to — narrowed to the passage the quote is about. Null on rows from before.
  officialTextSource OfficialTextSource?
  // Where in that authority, when it has a finer address: "s. 13" (UK Act), "para_37" (UK judgment).
  officialTextRef    String?
  status         CitationValidityStatus @default(UNVERIFIED)
  notes          String?                @db.Text
  checkedAt      DateTime               @default(now())

  // Lazily resolved the first time this case's Citation Map is opened — matches citedReference's
  // free text against the Law corpus (see resolveCitationToLaw). Null until resolution is
  // attempted or when no confident match exists; resolutionConfidence is null in both cases too.
  resolvedLawId        String?
  resolutionConfidence Float?

  // Pinpoint reference (e.g. "para. 4" or "p. 15") — lawyer-entered, or auto-detected for UK
  // via a live search of the resolved judgment's actual text (see grepJudgment); never a guess.
  pinpoint String?

  // How quotedText relates to officialText — QUOTED needs no LLM call (a plain text match
  // already answers it, see citation-validity.ts's containsQuote); PARAPHRASED/INFERRED come
  // from a short classification call only when the quote isn't a clean match. Null when there's
  // no officialText to classify against at all.
  propositionType CitationPropositionType?

  case        Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  resolvedLaw Law?                 @relation("ResolvedLaw", fields: [resolvedLawId], references: [id], onDelete: SetNull)
  grounds     CitationGround[]
  adverseHits AdverseCitationHit[]

  @@index([caseId])
  @@index([resolvedLawId])
}

enum CitationPropositionType {
  QUOTED
  PARAPHRASED
  INFERRED
}

model ProceduralDeadline {
  id               String   @id @default(uuid())
  caseId           String
  label            String
  ruleCode         String
  triggerDate      DateTime
  computedDueDate  DateTime
  ruleSource       String
  serviceMethod    String?
  calculationNotes String   @db.Text
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  case          Case                             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  confirmations ProceduralDeadlineConfirmation[]

  @@index([caseId])
}

model ProceduralDeadlineConfirmation {
  id         String   @id @default(uuid())
  deadlineId String
  userId     String
  confirmed  Boolean
  note       String?
  createdAt  DateTime @default(now())

  deadline ProceduralDeadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deadlineId, userId])
  @@index([deadlineId])
}

model ProcedureItem {
  id          String   @id @default(uuid())
  caseId      String
  kind        String
  label       String
  done        Boolean  @default(false)
  notes       String?  @db.Text
  // Which source document an AI-generated STRATEGY/TODO item is grounded in (see
  // CaseStrategySvc, case-strategy-parse.ts). Null for lawyer-entered items and for AI items
  // the model didn't attribute to a specific document.
  sourceLabel String?
  // Jev's verdict on a STRATEGY item against the case data (case-strategy-jev.ts):
  // { verdict, confidence, checkedAt }. Null for to-dos, lawyer-entered items, and when
  // USE_JEV_CASE_STRATEGY is off.
  check       Json?
  // A to-do sent over from another panel ("To checklist") remembers the item it was raised on, so
  // the item reaching its fixed state can tick it (utils/procedure-link.ts): FINDING, DAMAGE or
  // WITNESS_NEED, that row's id, and for a witness need the need's key. Not a foreign key — the
  // sources live in different tables, and the to-do outlives a deleted source.
  sourceKind  String?
  sourceId    String?
  sourceKey   String?
  // Set when the source ticked this to-do, with why (a ProcedureAutoCloseReason). Cleared when a
  // lawyer reopens it.
  autoClosedAt     DateTime?
  autoClosedReason String?
  // A to-do sent from a Damages & Remedies entry carries that entry's due date, and follows it.
  dueDate          DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, sourceKind, sourceId])
}

// ── Case Findings, Witnesses, Damages, Reconstruction ──────────────────────────

enum FindingCategory {
  LEGAL_ISSUE
  WEAKNESS
  STRENGTH
  ATTACK_STRATEGY
  DEFENSE_STRATEGY
}

// The pill on a Legal Issues / Weaknesses / Strengths / Attack Strategy / Defense Strategy row.
// One enum for all five categories; which values a category may use is
// FINDING_TAGS_BY_CATEGORY (case-finding.constants.ts).
enum FindingTag {
  CONTESTED
  BRIEFING
  OPEN
  RESOLVED
  MATERIAL
  MINOR
  CLOSED
  STRONG
  MODERATE
  READY
  DRAFTING
  BLOCKED
  ANSWERED
  PARTIAL
  UNANSWERED
}

// A short strategic-assessment entry, categorized by FindingCategory. Backs five Terminal
// panels (Legal Issues / Weaknesses / Strengths / Attack Strategies / Defense Strategies)
// from one table, mirroring how ProcedureItem.kind already distinguishes STRATEGY vs TODO.
// `notes === AI_FINDING_NOTE` ("AI") marks AI-authored rows — same discriminator convention
// as ProcedureItem's AI_PROCEDURE_NOTE — replaced wholesale on each AI (re)generation while
// manually-created rows (different/no notes) are left alone.
model CaseFinding {
  id           String          @id @default(uuid())
  caseId       String
  category     FindingCategory
  label        String
  notes        String?
  // Which source document an AI-generated finding is grounded in (see CaseFindingAiSvc,
  // case-finding-parse.ts). Null for lawyer-entered findings and for AI findings the model
  // didn't attribute to a specific document.
  sourceLabel  String?
  // The row's sub-line: who bears the burden (Legal Issues), the work that would close it
  // (Weaknesses), or the document reference (Strengths).
  detail       String?
  tag          FindingTag?
  // -10..10, the same scale as Red Team's argument impact. Null when nothing scored it.
  impact       Int?
  // Display order within a category; null rows sort by createdAt after the ordered ones.
  position     Int?
  // Jev's check of this finding (per-category shape, see the *-jev.ts utils). Null when Jev
  // wasn't run or its call failed; tag/impact are then the model's or the lawyer's own.
  jev          Json?
  // The drafting model's own tag/impact, kept for comparison once Jev has replaced them.
  modelTag     FindingTag?
  modelImpact  Int?
  jevCheckedAt DateTime?
  // When a lawyer last changed an AI row's label, detail or tag. A regeneration
  // (replaceAiFindings) keeps such rows instead of replacing them. Null for untouched rows.
  lawyerEditedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorities CaseAuthority[]

  @@index([caseId])
  @@index([caseId, category])
}

enum AuthorityKind {
  STATUTE
  CASE
}

// How an authority bears on the case — separate from CitationCheck.status, which only says
// whether a lawyer's quote matches its source. ADVERSE here means the authority hurts our side.
enum AuthorityStance {
  STATUTE
  ON_POINT
  ADVERSE
}

enum AuthoritySource {
  MANUAL
  AI
}

// Authority (statute or case) relied on for a case's grounds — backs the Terminal's Law &
// Precedent panel. findingId points at a CaseFinding with category LEGAL_ISSUE (the "ground");
// null when the authority isn't tied to one. Dismissing an authority deletes the row.
model CaseAuthority {
  id            String           @id @default(uuid())
  caseId        String
  kind          AuthorityKind
  stance        AuthorityStance
  title         String
  subtitle      String?
  citation      String?
  rationale     String?          @db.Text
  findingId     String?
  resolvedLawId String?
  source        AuthoritySource  @default(MANUAL)
  // Jev's second opinion on `stance` (see authority-stance-jev.ts) — never overwrites it; the panel
  // only offers it when it disagrees. Null when the USE_JEV_AUTHORITY flag is off or Jev failed.
  jevStance     AuthorityStance?
  jevConfidence Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  finding     CaseFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  resolvedLaw Law?         @relation(fields: [resolvedLawId], references: [id], onDelete: SetNull)

  @@index([caseId])
}

enum WitnessStatus {
  READY
  ADVERSE
  OUTSTANDING
}

enum WitnessSource {
  MANUAL
  AI
}

model Witness {
  id                  String         @id @default(uuid())
  caseId              String
  name                String
  role                String?
  summary             String?
  // AI = found by WitnessExtractSvc in `sourceDocumentId`; `sourceQuote` is the verbatim line it
  // relied on, checked against that document's text before the row is written.
  source              WitnessSource  @default(MANUAL)
  sourceDocumentId    String?
  sourceQuote         String?        @db.Text
  status              WitnessStatus  @default(OUTSTANDING)
  credibility         Int            @default(50)
  // AI-proposed values — never applied to status/credibility on their own. The displayed score is
  // credibilityOverride ?? aiCredibility ?? credibility, so re-scoring can't wipe a lawyer's edit.
  aiCredibility       Int?
  aiRationale         Json?
  aiSuggestedStatus   WitnessStatus?
  credibilityOverride Int?
  // Rubric audit trail (see src/utils/witness-rubric.ts). aiFactors: per factor A-G {answer, confidence,
  // quote, quoteVerified, documentName, by}. factorOverrides: lawyer changes {answer, note, by, at}, which
  // win over aiFactors when the score is recomputed. aiCredibility/aiSuggestedStatus stay the computed result.
  aiFactors           Json?
  aiRubricVersion     Int?
  factorOverrides     Json?
  // Keys of "what's needed" items the lawyer has ticked off (see witness-needs.ts); survives a rescore.
  needsDone           Json?
  scoredAt            DateTime?
  statementDueOn      DateTime?
  statementReceived   Boolean        @default(false)
  contact             String?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  case              Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceDocument    Document?            @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sponsoredEvidence EvidenceMatrixItem[]

  @@index([caseId])
}

// Whether an entry is money the client is owed (DAMAGE) or another order the case asks for, such
// as reinstatement (REMEDY).
enum DamageKind {
  DAMAGE
  REMEDY
}

enum DamageSource {
  MANUAL
  AI
}

enum DamageAmountBasis {
  STATED
  CALCULATED
  ESTIMATE
}

// One entry of the Damages & Remedies panel: a title, what it is, an amount (none for most
// remedies), whether it has been awarded or received, and the date it is due. The case total is
// the sum of accepted amounts (utils/damages-compute.ts).
model DamageClaim {
  id               String       @id @default(uuid())
  caseId           String
  kind             DamageKind   @default(DAMAGE)
  title            String
  description      String?      @db.Text
  amount           Float?
  // Where an AI entry's amount came from (a quoted figure, rate × period from quoted lines, or an
  // AI estimate to review) and its working. Cleared when a lawyer changes the amount.
  amountBasis      DamageAmountBasis?
  amountNote       String?      @db.Text
  // Awarded by the tribunal or received by the client.
  done             Boolean      @default(false)
  dueDate          DateTime?
  // AI = proposed by DamagesExtractSvc from `sourceDocumentId`; `sourceQuote` is the verbatim
  // line it relied on, checked against that document's text before the row is written.
  source           DamageSource @default(MANUAL)
  sourceDocumentId String?
  sourceQuote      String?      @db.Text
  // An AI proposal is a suggestion until a lawyer accepts it, and isn't counted in the total
  // until then. Lawyer-entered rows start accepted.
  accepted         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([caseId])
}

// An AI suggestion the lawyer deleted or renamed, by its damageHeadKey (kind + normalised title),
// so a later read of the case's documents doesn't propose it again.
model DamageClaimDismissal {
  id        String   @id @default(uuid())
  caseId    String
  key       String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, key])
}

// A legal claim/cause of action being pursued (e.g. "Breach of Contract", "Negligence") —
// distinct from DamageClaim, which is a monetary damages line item sought under one or more
// of these claims, not the legal theory itself.
model CaseClaim {
  id               String          @id @default(uuid())
  caseId           String
  title            String
  causeOfAction    String?
  description      String?         @db.Text
  // AI = proposed by ClaimExtractSvc from the pleadings; sourceLabel/sourceQuote then say which
  // document and the verbatim line it was found in (checked against that document's text).
  source           AuthoringSource @default(MANUAL)
  sourceLabel      String?
  sourceQuote      String?         @db.Text
  // The Document sourceLabel names, so the Citation Map can open it. A plain id, not a relation:
  // a deleted document just leaves the claim without a link. Null on claims found before this
  // was saved (the seed falls back to matching sourceLabel against the case's document names).
  sourceDocumentId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  case    Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  grounds CitationGround[]

  @@index([caseId])
}

enum AuthoringSource {
  MANUAL
  AI
}

// How an authority attaches to a pleaded ground in the Citation Map: SUBSTANTIVE when it states
// the rule the claim rests on, PROCEDURAL when it sets a procedure whose breach is the ground.
enum GroundRole {
  SUBSTANTIVE
  PROCEDURAL
}

enum AdverseHitKind {
  // The case's own citation check found the authority's text undermines what it's cited for.
  OWN_STATUS
  // A later decision in the corpus overruled, abandoned or distinguished the authority.
  NEGATIVE_TREATMENT
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

// One adverse signal against a case's cited authority, found by the Citation Map's sweep
// (AdverseSweepSvc). Rebuilt on each sweep; suggestionStatus/weaknessId carry over to the same
// hit (citationCheckId + edgeId) so a lawyer's accept/dismiss survives a re-run. A hit is only
// ever suggested as a Weakness — the lawyer accepts it (creating the CaseFinding) or dismisses it.
model AdverseCitationHit {
  id               String             @id @default(uuid())
  caseId           String
  citationCheckId  String
  kind             AdverseHitKind
  // The CitationEdge behind a NEGATIVE_TREATMENT hit, and what it recorded. Not a foreign key —
  // the hit keeps its record if the corpus edge is later re-extracted.
  edgeId           String?
  treatment        CitationTreatment?
  citingTitle      String?
  excerpt          String?            @db.Text
  // Jev's read of whether the treatment defeats what the case cites the authority for
  // (adverse-citation-jev.ts). Null for OWN_STATUS hits, or when Jev wasn't run or failed.
  jev              Json?
  jevCheckedAt     DateTime?
  suggestionStatus SuggestionStatus   @default(PENDING)
  // The Weakness created when the lawyer accepted the suggestion.
  weaknessId       String?
  createdAt        DateTime           @default(now())

  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  citationCheck CitationCheck @relation(fields: [citationCheckId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// One authority (a CitationCheck) attached to one pleaded ground (a CaseClaim) — the Citation
// Map's list view. AI links are replaced wholesale on each mapping run (CitationGroundSvc);
// MANUAL ones are left alone.
model CitationGround {
  id              String          @id @default(uuid())
  caseId          String
  citationCheckId String
  claimId         String
  role            GroundRole
  source          AuthoringSource
  // The mapping model's one-line reason for the link. Null on manual links.
  reason          String?
  // Jev's check of the link (citation-ground-jev.ts). Null when Jev wasn't run or failed.
  jev             Json?
  jevCheckedAt    DateTime?
  createdAt       DateTime        @default(now())

  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  citationCheck CitationCheck @relation(fields: [citationCheckId], references: [id], onDelete: Cascade)
  claim         CaseClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([citationCheckId, claimId])
  @@index([caseId])
}

// One narrative per Case (not a list, unlike CaseFinding) — regenerated in place by AI on
// demand (a dedicated action, not bundled into the general Refresh, since long-form
// generation is a heavier/slower single call) and editable afterward by the lawyer.
// Case Reconstruction's dated event chain (Events tab). Its own table, not a column on
// CaseReconstruction: the chain is built from the case's documents, not from the narrative, and
// CaseReconstruction rows only exist once a narrative has been generated. Each event is a factual
// proposition with one quote-verified source and a Verified / Disputed / Unverified status — see
// ReconstructionEvent in case-reconstruction-events-parse.ts. Statuses come from Jev only when
// USE_JEV_RECONSTRUCTION=true; otherwise every event is Unverified.
model CaseReconstructionEvents {
  id        String   @id @default(uuid())
  caseId    String   @unique
  events    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseReconstruction {
  id                String    @id @default(uuid())
  caseId            String    @unique
  narrative         String    @db.Text
  // "For the court" and "from the other side" registers (PDF's Narrative Engine window) —
  // nullable since a reconstruction generated before this field existed has narrative only.
  narrativeCourt    String?   @db.Text
  narrativeOpposing String?   @db.Text
  // Qualitative "what this doesn't explain" list — deliberately not a coverage percentage,
  // which isn't honestly groundable given the prompt only sees a sampled excerpt pack.
  gaps              String[]  @default([])
  // Claim-level attribution for `narrative` only (the General register — the one that isn't
  // reframed/redacted like Court/Opposing) — same shape and matching approach as
  // RedTeamAssessment.claims (see extractReconstructionClaims): a verbatim-substring quote
  // matched back onto the text at render time. Cleared whenever `narrative` is hand-edited
  // (see CaseReconstructionSvc.update) since a stale claim would otherwise mismatch silently.
  claims            Json?
  // Audio narration (General/narrative register only) — async AWS Polly job, same
  // start-job/poll-status shape as Transcription's AWS Transcribe integration.
  audioFileId       String?
  audioJobName      String?
  audioStatus       String?
  audioStaleAt      DateTime?
  // Rung 1 (differentiation program, Phase 3 — Workstream C): the timeline reconstructed as an
  // ordered scene script — see Scene in case-reconstruction-scenes-parse.ts for the JSON shape.
  // Generated by a dedicated action (CaseReconstructionSvc.generateScenes), not bundled into
  // the main narrative generate — a lawyer may want the narrative without paying for scenes.
  // Every sourceRef is verified (docId resolves to a real case document; quote, if given,
  // appears in that document's sampled text) before being kept; an unverifiable ref is dropped
  // from the scene, and if a scene ends up with none, that's itself recorded in `unresolved`
  // rather than silently shipping an ungrounded scene.
  scenes            Json?
  // Rung 2 — multi-voice "table read" audio rendered from `scenes` (one Polly voice per actor,
  // a narrator voice for action lines), reusing Audio Overview's synthesize-many-short-turns +
  // ffmpeg-concat pipeline (mergeCastTurnsToMp3) rather than case reconstruction narration's
  // single-voice async Polly task — same reasoning Audio Overview used: many short clips beat
  // one call's length limits. Stale (not regenerated) whenever `scenes` changes underneath it.
  tableReadFileId   String?
  tableReadStatus   String?
  tableReadStaleAt  DateTime?
  // Set when a lawyer edits any of the three registers (CaseReconstructionSvc.update), cleared
  // by every generate. While set, the analysis refresh leaves the narrative alone rather than
  // overwriting the lawyer's words (CaseReconstructionSvc.autoRegenerate).
  narrativeEditedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  case          Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  audioFile     File? @relation("CaseReconstructionAudio", fields: [audioFileId], references: [id])
  tableReadFile File? @relation("CaseReconstructionTableRead", fields: [tableReadFileId], references: [id])
}

// The "Red Team" panel — an adversarial threat assessment generated from the case's own
// structured findings (Legal Issues, Weaknesses, Contradictions, Witnesses, Damages), not
// from raw document text. One assessment per case, regenerated in place. No manual edit,
// unlike CaseReconstruction — this is meant to be read as opposing counsel's own commentary,
// not something the lawyer rewrites in their own voice.
model RedTeamAssessment {
  id        String   @id @default(uuid())
  caseId    String   @unique
  content   String   @db.Text
  // Claim-level attribution (RedTeamClaim[] from red-team-claims-parse.ts) — which sentences
  // are grounded in a specific case-data item vs. AI inference vs. flagged unsupported. Matched
  // back onto `content` at render time (components/shared/attributed-text.tsx); `content`
  // itself is never modified, so this stays valid even across future edits/regenerations.
  claims    Json?
  // Ranked opposing arguments (RedTeamArguments from red-team-arguments-parse.ts) — each one
  // resolved to the case item it rests on. Null on assessments generated before this existed,
  // or if the model's [ARGUMENTS] block didn't parse; the panel then shows only `content`.
  arguments Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// What one analysis refresh (CaseRefreshSvc.refreshInner) changed in the panes it rewrote, compared
// with what they said before it — read by the Legal Terminal's "What changed" modal. One row per
// finished refresh, written once after the last wave and never updated. The row's id is the run's
// id (AiGenerationJob is one row per case+kind, reused by every run). Holds case content (finding
// labels, contradiction values, document names), so it goes with the case — unlike AuditEvent,
// which outlives it.
model CaseChangeSummary {
  id               String   @id @default(uuid())
  caseId           String
  // "manual" (Refresh analysis), "post-extraction" (the automatic run after a corpus change), or
  // "regenerate" (one pane's own Regenerate — perPaneDeltas holds that pane alone, and the
  // document fields stay empty: it read no new evidence).
  reason           String
  actorId          String?
  // READY, unarchived documents this run read (mindMapDocumentIds) — the next run diffs against it.
  readyDocumentIds String[] @default([])
  // [{ id, name }] relative to the previous summary's readyDocumentIds. Both empty on a case's
  // first summary, and on a manual run with no document change.
  documentsAdded   Json     @default("[]")
  documentsRemoved Json     @default("[]")
  // countChanges(perPaneDeltas) — what the modal's headline counts.
  totalChanges     Int      @default(0)
  // The case's first analysis: every pane was empty before it, so everything it wrote reads as
  // "added". The modal stays quiet for it; there was nothing to change.
  firstAnalysis    Boolean  @default(false)
  // CaseChangeDeltas (types/case-change.ts), one entry per pane the refresh tracks.
  perPaneDeltas    Json
  // When the run began (createdAt is when it saved). Lawyers' edits between the previous run's
  // save and this start are "edits since the previous run". Null on rows from before it existed.
  startedAt        DateTime?
  createdAt        DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

// One edit a lawyer made by hand in a Terminal pane (ManualEditLog) — the Change Summary's record of
// manual changes, grouped into editing sessions when read (utils/manual-edit-sessions.ts). Written
// once, except that the same person editing the same field of the same item again within five
// minutes updates the row instead of adding one. The AI's own writes are never recorded here.
// Holds case content (item names), so it goes with the case.
model CaseManualEdit {
  id        String   @id @default(uuid())
  caseId    String
  actorId   String?
  // The Terminal pane (a PanelId) the item shows in — types/manual-edit.ts.
  pane      String
  // What was edited: finding, contradiction, todo, witness, … (ManualEditKind).
  kind      String
  itemId    String?
  // added | edited | removed | resolved | ticked | accepted | … (ManualEditAction).
  action    String
  // The item's name when it was edited, kept after a delete.
  label     String
  // [{ field, from?, to? }]: short values keep from/to; long text only names the field.
  changes   Json?
  createdAt DateTime @default(now())

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([caseId, actorId, itemId])
}

// ── Case Graph (Phase A: dependency tracking + staleness, no auto-recompute) ───────────────
//
// Phase A proved one real edge — CaseTimelineEvent -> ProceduralDeadline — with just
// TIMELINE_EVENT/PROCEDURAL_DEADLINE. Phase B (this) registers the rest of a case's canonical,
// lawyer/AI-authored entities as nodes so panels beyond the Terminal (e.g. Mind Map, Evidence
// Matrix) can key off one shared identity per entity instead of re-deriving it, and so a future
// edge between any two of them costs nothing beyond a service call. WITNESS/DAMAGE_CLAIM/
// FINDING/CLAIM are actively registered (see WitnessSvc/DamageClaimSvc/CaseFindingSvc/
// CaseClaimSvc — ensureNode on create, markStale on update). DOCUMENT and PARTY are declared
// for a complete vocabulary but not yet wired: Document's creation path is shared across
// case/consultation/no-case uploads with no single safe insertion point, and Party is fully
// replaced (delete-all + recreate) on every Case edit, which can't hold a stable refId across
// edits — both need their own follow-up once there's a real edge that needs them. Linking is
// always explicit (a service call), never inferred — matches this codebase's existing
// hand-wired reactive style (CaseRefreshSvc, scheduleCasePostExtraction), not a generic
// Prisma-hook/event-bus mechanism.
enum CaseGraphNodeType {
  TIMELINE_EVENT
  PROCEDURAL_DEADLINE
  WITNESS
  DOCUMENT
  PARTY
  DAMAGE_CLAIM
  FINDING
  CLAIM
  DECISION
  THEORY
}

model CaseGraphNode {
  id          String            @id @default(uuid())
  caseId      String
  nodeType    CaseGraphNodeType
  refId       String
  staleAt     DateTime?
  staleReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  outgoingEdges     CaseGraphEdge[] @relation("CaseGraphEdgeSource")
  incomingEdges     CaseGraphEdge[] @relation("CaseGraphEdgeTarget")
  outgoingCaseEdges CaseEdge[]      @relation("CaseEdgeSource")
  incomingCaseEdges CaseEdge[]      @relation("CaseEdgeTarget")

  @@unique([nodeType, refId])
  @@index([caseId])
}

model CaseGraphEdge {
  id           String   @id @default(uuid())
  caseId       String
  sourceNodeId String
  targetNodeId String
  kind         String
  createdAt    DateTime @default(now())

  case   Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  source CaseGraphNode @relation("CaseGraphEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target CaseGraphNode @relation("CaseGraphEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, kind])
  @@index([caseId])
  @@index([targetNodeId])
}

// Evidentiary/argumentation links between CaseGraphNode entities (the canonical node registry
// from Phase B, above) — "this witness statement CONTRADICTS that timeline event", "this
// document PROVES this claim". Deliberately a separate table from CaseGraphEdge: that one is
// Phase A/B's dependency+staleness engine with a free-form `kind`, walked only for recompute
// closure; this one backs the Mind Map/citation-map UI, has a closed relation vocabulary the
// UI renders distinctly, and carries per-edge metadata (e.g. the citation/quote backing a
// CITES link). A deleted node cascades here at the FK level, and CaseEdgeSvc.archiveForNode
// snapshots the row into CaseEdgeArchive first — see that service for why this is an explicit
// call plus a DB trigger rather than either alone.
enum CaseEdgeRelationType {
  SUPPORTS
  CONTRADICTS
  CITES
  PROVES
  REFUTES
  SPONSORS
}

model CaseEdge {
  id             String               @id @default(uuid())
  caseId         String
  sourceEntityId String
  targetEntityId String
  relationType   CaseEdgeRelationType
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceEntity CaseGraphNode @relation("CaseEdgeSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity CaseGraphNode @relation("CaseEdgeTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([sourceEntityId, targetEntityId, relationType])
  @@index([caseId])
  @@index([targetEntityId])
}

// Snapshot of a CaseEdge row taken by the archive_case_edge() trigger the instant before a
// cascade delete (node removed, or its Case removed) would otherwise erase it — see the
// migration SQL for the trigger and CaseEdgeSvc for the read path. No FKs back to the live
// tables: by the time a row lands here, the entity/case it referenced may already be gone.
model CaseEdgeArchive {
  id             String               @id @default(uuid())
  caseId         String
  sourceEntityId String
  targetEntityId String
  relationType   CaseEdgeRelationType
  metadata       Json
  createdAt      DateTime
  updatedAt      DateTime
  archivedAt     DateTime             @default(now())

  @@index([caseId])
}

model Organization {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  packageSku  PackageSku @default(PROFESSIONAL)
  // A user who skipped workspace onboarding still needs an org (every resource route is
  // org-scoped), so they get a private one-member workspace that the app never presents as
  // an organization. Creating a real org upgrades it in place — see OrganizationSvc.create.
  isPersonal  Boolean    @default(false)
  createdById String
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy      User                   @relation("OrgCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members        OrganizationMember[]
  invites        OrganizationInvite[]
  emailInvites   OrganizationEmailInvite[]
  caseCopies     CaseCopy[]
  consultationCopies ConsultationCopy[]
  cases          Case[]
  documents      Document[]
  consultations  Consultation[]
  bookmarks      Bookmark[]
  events         Event[]
  notes          Note[]
  notifications  Notification[]
  transcriptions Transcription[]
  connectors     IntegrationConnector[]

  @@index([createdById])
  @@index([tenantId])
}

model Tenant {
  id                        String                     @id @default(uuid())
  code                      String                     @unique
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  organizations             Organization[]
  legalSourceAnalysisCaches LegalSourceAnalysisCache[]
  laws                      Law[]
  settings                  TenantSetting[]
}

// Admin-editable settings scoped to one Tenant (PH / UK) — one row per (tenant, key).
// Read through TenantSettingSvc (Redis-cached); a missing row means the setting's default.
// Today only "signup.autoApprove" (see TENANT_SETTING_KEYS); an email-domain allow-list
// could live here later.
model TenantSetting {
  tenantId    String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([tenantId, key])
  @@index([updatedById])
}

// userId is globally unique — a user belongs to at most one Organization (see
// OrganizationMemberRepo's find()/findAnyForUser() comment; multi-org membership
// isn't supported yet).
model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String
  userId         String                   @unique
  role           OrganizationRole         @default(OWNER)
  // Always ACCEPTED now — invitations live in OrganizationInvite. PENDING is what invites used
  // to be stored as here, before 20261007150000_organization_invites moved them out.
  status         OrganizationMemberStatus @default(ACCEPTED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// An invitation to join an organization. Kept apart from OrganizationMember (one row per
// user) so that someone who already belongs to an organization can still be invited —
// accepting moves their membership (see OrganizationSvc.acceptInvite), declining leaves it.
// One outstanding invite per user.
model OrganizationInvite {
  id             String           @id @default(uuid())
  organizationId String
  userId         String           @unique
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// An invite to an email address with no account yet. When that address signs up and is
// verified, AuthSvc turns it into an OrganizationInvite (and the invite approves the account),
// so accepting works exactly as for a registered invitee. email is unique for the same reason
// OrganizationInvite.userId is: one outstanding invite at a time.
model OrganizationEmailInvite {
  id             String           @id @default(uuid())
  organizationId String
  email          String           @unique
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum CaseCopyStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// One portfolio copy to make: a case its creator made in an organization they've just left
// (left, removed, or switched away from by accepting an invite). Written in the same transaction
// as the membership change; CaseCopyQueue works through them in the background.
model CaseCopy {
  id                     String         @id @default(uuid())
  sourceCaseId           String
  // Snapshots, so the portfolio can show "Copying <case> from <org>…" before the copy exists.
  caseName               String
  sourceOrganizationName String
  userId                 String
  targetOrganizationId   String
  status                 CaseCopyStatus @default(PENDING)
  copyCaseId             String?
  attempts               Int            @default(0)
  error                  String?        @db.Text
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetOrganization Organization @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, updatedAt])
}

// One portfolio copy to make of a standalone consultation (one not on a case) that a member
// started in an organization they've just left. Consultations are shared with the organization,
// so like a case it keeps the original and the member gets a copy. Case consultations go with
// their case instead (see CaseCopy). Worked through by CaseCopyQueue alongside CaseCopy.
model ConsultationCopy {
  id                   String         @id @default(uuid())
  sourceConsultationId String
  userId               String
  targetOrganizationId String
  status               CaseCopyStatus @default(PENDING)
  copyConsultationId   String?
  attempts             Int            @default(0)
  error                String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetOrganization Organization @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, updatedAt])
}

enum ProductTourStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

// A user's progress through an onboarding tour (the app's spotlight walkthrough). The step
// scripts live in ilovelawyer-app (lib/tour) — this only remembers where the user is, so the
// tour follows them across devices. One row per track — one per page tour, see
// PRODUCT_TOUR_TRACKS.
model ProductTour {
  userId      String
  track       String            @default("main")
  status      ProductTourStatus @default(NOT_STARTED)
  // The "How do you practice?" answer that picked the step script — see PRODUCT_TOUR_ARCHETYPES.
  archetype   String?
  currentStep String?
  doneSteps   String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, track])
}

model CaseAccess {
  id         String         @id @default(uuid())
  caseId     String
  userId     String
  permission CasePermission @default(VIEW)
  createdAt  DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
}

// What a user has agreed to, per purpose. Terms of Service is not a row here: it stays on
// User.termsAcceptedAt/termsVersion and ConsentSvc reports it from there. A row exists once the
// user has answered for a purpose; no row means they have not been asked. `version` is the
// version of the policy text they answered for (see constants/consent.constants.ts).
enum ConsentPurpose {
  TERMS_OF_SERVICE
  AI_PROCESSING
  ANALYTICS
  MARKETING
}

model Consent {
  id          String         @id @default(uuid())
  userId      String
  purpose     ConsentPurpose
  version     String
  grantedAt   DateTime
  withdrawnAt DateTime?
  source      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  caseId    String?
  actorId   String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  case  Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

enum SecurityAuditOutcome {
  SUCCESS
  FAILURE
}

// The security audit log (docs/adr/0006-security-audit-log.md): sign-in, membership and
// permission changes, admin actions, exports and downloads, deletions — what a firm's security
// questionnaire asks about. Kept apart from AuditEvent, which is the case activity feed and also
// drives mind map / Case Strategy staleness, so nothing written here can mark a pane stale.
//
// Append-only, enforced in Postgres (see the security_audit_event migration's triggers): UPDATE
// and TRUNCATE are refused, and DELETE is refused for any row younger than the retention floor —
// only SecurityAuditRetentionQueue removes rows, once they age out. No foreign keys on purpose:
// a row must outlive the user, case and organization it names, so ids are plain strings and the
// actor's email is snapshotted. Rows carry ids and counts, never case content.
model SecurityAuditEvent {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now())
  /// Dotted action name from SECURITY_AUDIT_ACTIONS (src/constants/security-audit.constants.ts).
  action         String
  outcome        SecurityAuditOutcome @default(SUCCESS)
  /// The firm the event belongs to — what an org Owner/Admin's audit log view filters on. Null for
  /// events outside any organization (a failed login for an unknown email, platform settings).
  organizationId String?
  tenantCode     String?
  /// Who did it. Null when nobody signed in did (a failed login, a system sweep).
  actorId        String?
  /// The actor's email at the time — kept so the row still names them after their account is gone.
  actorEmail     String?
  /// What it was done to: "user", "organization", "case", "document", "consultation", "file", ...
  targetType     String?
  targetId       String?
  /// The target's name as it read when the row was written — set only where the target is about
  /// to stop existing (a deleted document, case or transcription), so the log can still say which
  /// one. Live targets are named from their current record when the log is read.
  targetName     String?
  caseId         String?
  ip             String?
  userAgent      String?
  requestId      String?
  payload        Json?

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([caseId])
  @@index([createdAt])
}

model JurisdictionModule {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  enabled    Boolean  @default(true)
  language   String   @default("en")
  configJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model IntegrationConnector {
  id             String          @id @default(uuid())
  userId         String?
  organizationId String?
  type           ConnectorType
  status         ConnectorStatus @default(DISCONNECTED)
  configJson     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// ── AI generation locks ─────────────────────────────────────────────────────────
// Generic "is a generation currently running" marker, shared by every Chat-Wonder-backed
// Generate/Refresh/Scan action (Red Team, Case Reconstruction, Contradictions, the global
// case refresh, Mind Map, Audio Overview's script step, and PH Citation Map's per-node
// expand). Without this, a page refresh mid-generation looks idle even though the server-side
// call is still running, inviting a duplicate click. `subjectId` is deliberately not a
// relation — it's a caseId for the case-level kinds above, a Law.id for citationExpand — this
// is a generic lock, not a domain entity. See AiGenerationLockSvc.
model AiGenerationJob {
  id         String             @id @default(uuid())
  subjectId  String
  kind       String
  status     AiGenerationStatus @default(IN_PROGRESS)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  error      String?
  /// Where an IN_PROGRESS job has got to, for a progress indicator — null until the job reports
  /// one (AiGenerationLockSvc.setStage). Only Chat-Wonder-backed chat turns report stages today
  /// ("answering", then "extras"); every other kind leaves it null throughout.
  stage      String?
  /// Stamped every few seconds while the job's work is running (AiGenerationLockSvc.finishWith).
  /// A run whose heartbeat stopped was lost — the API process restarted or crashed mid-run — and
  /// is treated as abandoned no matter how long legitimate runs of its kind take. Null until the
  /// work starts (a job still waiting in the queue), which falls back to an age check on startedAt.
  heartbeatAt DateTime?

  @@unique([subjectId, kind])
  @@index([subjectId])
}

enum AiGenerationStatus {
  IN_PROGRESS
  DONE
  FAILED
}

/// One checkable claim pulled out of an assistant answer and what the bundle says about it — see
/// docs/plans/grounding-verifier.md. Written after the answer is already persisted, so a failure
/// here can never cost the lawyer their reply; a turn with no rows simply was not verified.
model AnswerGroundingCheck {
  id           String   @id @default(uuid())
  /// The assistant Message this verifies.
  messageId    String
  caseId       String?
  /// "ABSENCE_CLAIM" (the answer said material was unavailable) or "ASSERTION" (the answer stated
  /// a fact and cited a document for it).
  kind         String
  /// The sentence from the answer, so a verdict can be read without re-deriving it.
  assertion    String   @db.Text
  /// The reference exactly as the answer wrote it: "D14 Part 2", "D20.1 para. 6".
  citation     String?
  /// Resolved bundle document, null when the reference named nothing resolvable.
  documentId   String?
  /// What was actually checked against — kept so a disputed verdict can be audited.
  passage      String?  @db.Text
  /// FALSE_ABSENCE | NOT_SUPPLIED | CORRECT_ABSENCE | UNRESOLVED | SUPPORTED | UNSUPPORTED |
  /// CONTRADICTED. A string rather than an enum so a new verdict never needs a migration, the
  /// same reasoning as AI_GENERATION_KINDS and MESSAGE_INTENTS.
  verdict      String
  /// Null when the verdict was reached without Jev (every absence verdict is decided by lookup).
  confidence   Float?
  /// Criterion E: ASSERTED_BY_PARTY | STATED_BY_WITNESS | SHOWN_BY_DOCUMENT | ESTABLISHED.
  evidenceKind String?
  createdAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([caseId, verdict])
}
