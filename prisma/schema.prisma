  role      String?
  contact   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case              Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sponsoredEvidence EvidenceMatrixItem[]

  @@index([caseId])
}

