generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

// State machine (admin-driven except the initial PENDING on signup):
//   PENDING  --approve-->    ACTIVE
//   PENDING  --deny-->       DENIED
//   DENIED   --reactivate--> ACTIVE
//   ACTIVE   --block-->      BLOCKED
//   BLOCKED  --unblock-->    ACTIVE
// No other transitions are valid — see AdminSvc, which rejects any attempt outside these edges.
enum ApprovalStatus {
  PENDING
  ACTIVE
  DENIED
  BLOCKED
}

model User {
  id                 String    @id @default(uuid())
  // Always stored trimmed + lowercased (see normalizeEmail in src/utils/auth.utils.ts and the
  // normalize_user_emails migration) — @unique is therefore effectively case-insensitive.
  email              String    @unique
  password           String?
  name               String?
  username           String    @unique
  role               Role      @default(USER)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  provider           String?
  googleId           String?   @unique
  googleAccessToken  String?
  googleRefreshToken String?
  // Where two-way Google Calendar sync left off (Google's events.list syncToken). Null → the next
  // poll takes a fresh baseline. Reset on connect and disconnect.
  googleCalendarSyncToken String?
  avatarId           String?
  tenantId           String?
  isEmailVerified    Boolean   @default(false)

  // Set true for every account that existed before the strong-password policy shipped
  // (see the add_must_change_password migration's backfill) and for any account whose
  // password otherwise falls outside the current policy. Checked by AuthSvc.login, which
  // blocks the session and routes the client to AuthSvc.updateRequiredPassword instead.
  // Cleared the moment that succeeds — a one-time gate, never re-asked after that.
  mustChangePassword Boolean @default(false)

  // Terms of Service acceptance, recorded at account creation for both password signup and
  // first-time Google signup (AuthSvc.loginWithGoogle refuses to create a Google account
  // without it — see TERMS_ACCEPTANCE_REQUIRED). termsVersion is TERMS_VERSION at that time.
  // Null for accounts created before acceptance was recorded server-side; those aren't
  // re-prompted.
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Independent of Email Verification and of login itself — a new User starts PENDING
  // regardless of signup method. Login still succeeds for a PENDING/DENIED user (they
  // need a session to finish solo/org setup and to see /account-pending); the frontend's
  // protected-route guard is what keeps them out of the real app. denialReason is
  // admin-authored, optional, shown to the user in the denial email/page.
  approvalStatus      ApprovalStatus @default(PENDING)
  denialReason        String?
  onboardingCompleted Boolean        @default(false)

  // Self-service deletion request. Set when the user requests deletion from their profile;
  // the account (and all its data) is hard-deleted by AccountDeletionQueue once
  // ACCOUNT_DELETION_GRACE_PERIOD_DAYS has elapsed since this timestamp, unless the user
  // cancels first by clearing it back to null — or signs in again, which does the same (see
  // AccountDeletionSvc.restoreOnSignIn). Null means no deletion is scheduled.
  deletionRequestedAt        DateTime?
  otpCode                    String?
  otpExpiry                  DateTime?
  emailVerificationOtp       String?
  emailVerificationOtpExpiry DateTime?

  // Signup email verification — deliberately separate from otpCode/otpExpiry
  // above (which belong to the password-reset flow) so the two one-time-code
  // flows can't clobber each other. See docs/adr/0001-email-verification-otp.md.
  emailVerificationCode       String?
  emailVerificationExpiry     DateTime?
  emailVerificationAttempts   Int       @default(0)
  emailVerificationLastSentAt DateTime?

  // One-time "Login" link sent in the admin-approval email (AdminSvc.transition, approve
  // action only) — its own dedicated pair, separate from both otpCode/otpExpiry
  // (password reset) and emailVerificationCode (signup OTP), so none of the three
  // one-time-token flows can clobber each other.
  loginLinkToken       String?
  loginLinkTokenExpiry DateTime?

  sessions                 Session[]
  productTours             ProductTour[]
  traceEvents              ConsultationTraceEvent[]
  avatar                   File?                     @relation(fields: [avatarId], references: [id])
  consultations            Consultation[]
  messages                 Message[]
  createdInvites           ConsultationInvite[]
  consultationParticipants ConsultationParticipant[]
  packageSku               PackageSku                @default(SOLO)
  preferredLanguage        String                    @default("en")

  cases                   Case[]
  documents               Document[]
  bookmarks               Bookmark[]
  consents                Consent[]
  transcriptions          Transcription[]
  calendarWatchChannels   CalendarWatchChannel[]
  events                  Event[]
  notes                   Note[]
  notifications           Notification[]
  terminalWorkspaces      TerminalWorkspace[]
  screenPresets           ScreenPreset[]
  organizationMemberships OrganizationMember[]
  organizationInvites     OrganizationInvite[]
  caseCopies              CaseCopy[]
  consultationCopies      ConsultationCopy[]
  createdOrganizations    Organization[]                   @relation("OrgCreator")
  ownedRisks              CaseRisk[]
  auditEvents             AuditEvent[]
  caseAccesses            CaseAccess[]
  integrationConnectors   IntegrationConnector[]
  deadlineConfirmations   ProceduralDeadlineConfirmation[]
  caseBriefExports        CaseBriefExport[]
  caseViews               CaseView[]
  updatedTenantSettings   TenantSetting[]
  tenant                  Tenant?                          @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([deletionRequestedAt])
  manualEdits        CaseManualEdit[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  refreshToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id                          String                     @id @default(uuid())
  filename                    String?
  fileUrl                     String?
  s3Key                       String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  deletedAt                   DateTime?
  metaData                    Json?
  users                       User[]
  transcriptions              Transcription[]
  caseDocuments               Document[]
  caseReconstructionAudio     CaseReconstruction[]       @relation("CaseReconstructionAudio")
  caseReconstructionTableRead CaseReconstruction[]       @relation("CaseReconstructionTableRead")
  audioOverviews              MessageAudioOverview[]
  caseBriefExports            CaseBriefExport[]
  generatedDocuments          MessageGeneratedDocument[]
  fileStatus                  FileStatus?                @default(ACTIVE)
}

enum FileStatus {
  FOR_DELETION
  ACTIVE
}

enum Role {
  USER
  ADMIN
}

enum PackageSku {
  SOLO
  PROFESSIONAL
  ENTERPRISE
}

// ── Chat ──────────────────────────────────────────────────────────────────────

model Consultation {
  id             String                   @id @default(uuid())
  // On a portfolio copy (see CaseCopySvc): the consultation in the original case this was copied
  // from, so the copy can later be compared with the original item by item. No foreign key.
  copiedFromId String?
  userId         String
  organizationId String
  caseId         String?
  title          String?
  // Who set `title` — decides whether the AI may still change it (see ChatSvc title handling).
  // Null while untitled.
  titleSource    ConsultationTitleSource?
  createdAt      DateTime                 @default(now())
  // When the most recent Jev-triaged user message was flagged urgent (see message-triage.ts).
  // Set on an urgent turn, cleared on the next routine one, so the consultation list can badge
  // and sort chats that currently need attention without walking every message. Null when
  // triage is off or has never run for this consultation.
  urgentAt       DateTime?
  // Archiving is the soft delete: an ARCHIVED consultation leaves the lists (it shows only in
  // the Archived section, ?status=ARCHIVED), takes no new messages, and can be restored as it
  // was. Deleting is only offered from there and moves it to FOR_DELETION — still listed under
  // Archived and restorable until ConsultationDeletionQueue purges it. See ChatSvc.deleteConsultation.
  status         ConsultationStatus        @default(ACTIVE)
  // When it was last archived — the Archived list's sort key. Null while ACTIVE.
  archivedAt     DateTime?
  // When it moved to FOR_DELETION — the grace period counts from here. It stays restorable
  // (which clears this) for CONSULTATION_DELETION_GRACE_PERIOD_DAYS, then
  // ConsultationDeletionQueue purges it. Null unless FOR_DELETION.
  deletionRequestedAt DateTime?

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case           Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  messages       Message[]
  messageGroups  MessageGroup[]
  invites        ConsultationInvite[]
  participants   ConsultationParticipant[]
  traceEvents    ConsultationTraceEvent[]
  documents      Document[]
  transcriptions Transcription[]

  @@index([userId])
  @@index([organizationId])
  @@index([caseId])
  @@index([organizationId, caseId, status])
  @@index([deletionRequestedAt])
}

enum ConsultationStatus {
  ACTIVE
  ARCHIVED
  FOR_DELETION
}

model Message {
  id                  String              @id @default(uuid())
  consultationId      String
  role                MessageRole
  content             String              @db.Text
  imagePreview        String?
  timestamp           DateTime?
  createdAt           DateTime            @default(now())
  userId              String?
  parentMessageId     String?
  // Set only when this reply is one topic of a split, multi-topic answer (see
  // MessageGroup) — null for every ordinary, unsplit message.
  groupId             String?
  groupOrder          Int?
  groupTitle          String?
  // Tracks a user turn's assistant reply through generation — set to PENDING when this
  // (user-role) message is created, before streaming starts, so a page load can tell
  // "still generating" from "reply never came" from durable state instead of any
  // in-memory client flag. Flipped to DONE once persistAssistantTurn runs, or FAILED if
  // generation throws before ever enqueueing. Always null on assistant/system messages.
  replyStatus         MessageReplyStatus?
  // Raw accumulated reply text, checkpointed periodically while still streaming (see
  // ChatSvc.sendMessage) — lets a mid-generation page refresh show the partial answer
  // instead of a bare "thinking" indicator until the real persisted reply lands. Cleared
  // once replyStatus flips to DONE.
  pendingReplyContent String?             @db.Text
  // Jev triage result for a user-role message (see message-triage.ts / USE_JEV_MESSAGE_TRIAGE):
  // urgency flag + probability, and what the user is asking for (intent — one of
  // MESSAGE_INTENTS in message-triage.ts, a string rather than an enum so a new intent never
  // needs a migration) with its confidence. All four null when triage didn't run (flag off, Jev
  // error, or a message from before these columns existed) — never a mix. Always null on
  // assistant messages.
  urgent              Boolean?
  urgencyProbability  Float?
  intent              String?
  intentConfidence    Float?
  // Jev's probability that the message depends on a document/file/email the user thinks they
  // supplied. Stored so "answered about a document it never had" is queryable after the fact.
  refersToAttachment  Float?

  consultation      Consultation              @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user              User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent            Message?                  @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies           Message[]                 @relation("MessageThread")
  group             MessageGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  timeline          MessageTimeline?
  mindMap           MessageMindMap?
  relatedCases      MessageRelatedCases?
  citationRanking   MessageCitationRanking?
  audioOverview     MessageAudioOverview?
  reasoning         MessageReasoning?
  decisionRecords   MessageDecisionRecord?
  researchSteps     MessageResearchSteps?
  documents         Document[]
  generatedDocument MessageGeneratedDocument?
  groundingChecks   AnswerGroundingCheck[]

  @@index([consultationId])
  @@index([userId])
  @@index([parentMessageId])
  @@index([groupId])
}

// One AI turn split into several topical Message rows (see docs on MessageGroup
// handoff) — each sibling row is its own chat bubble, ordered by groupOrder. A turn
// that wasn't split has no MessageGroup at all; its Message.groupId stays null.
model MessageGroup {
  id             String   @id @default(uuid())
  consultationId String
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([consultationId])
}

model MessageTimeline {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

/// `data` is always the current tree — what every reader (chat history, Studio) shows. `version`
/// counts edits to it (1 = as generated); every version, the current one included, is kept in
/// MindMapRevision so "Undo expand" can step back. `createdAt` stays the *generation* time on
/// purpose: CaseSnapshot's Stale badge compares it with case activity, and expanding a node
/// doesn't rebuild the rest of the map from newer case facts.
model MessageMindMap {
  id        String   @id @default(uuid())
  messageId String   @unique
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())

  message   Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  revisions MindMapRevision[]
}

/// One saved version of a mind map's tree — a chat message's map (MessageMindMap) or a case's
/// document-built map (CaseMindMap); exactly one of the two ids is set. Written lazily for
/// message maps (their version-1 row is backfilled on the first expand); every auto build of a
/// case map writes one. Undo deletes the newest row and restores the one before it, so this is a
/// linear undo stack, not a branching history.
model MindMapRevision {
  id               String   @id @default(uuid())
  messageMindMapId String?
  caseMindMapId    String?
  version          Int
  data             Json
  /// "generate" | "expand" | "edit" | "auto" — a string, not an enum, for the same reason as
  /// AiGenerationJob.kind: new reasons shouldn't need a migration.
  reason           String
  /// Path id of the expanded/edited node; null for "generate"/"auto".
  nodeId           String?
  createdById      String?
  createdAt        DateTime @default(now())

  mindMap     MessageMindMap? @relation(fields: [messageMindMapId], references: [id], onDelete: Cascade)
  caseMindMap CaseMindMap?    @relation(fields: [caseMindMapId], references: [id], onDelete: Cascade)

  @@unique([messageMindMapId, version])
  @@unique([caseMindMapId, version])
}

/// The case's mind map built straight from its uploaded documents (CaseMindMapSvc), as opposed
/// to a MessageMindMap, which a chat turn produced. One per case, rebuilt by the post-upload
/// refresh (CaseRefreshSvc) whenever the READY document set changes — unless someone has
/// expanded/edited it since the last build, in which case it's left alone and goes Stale.
/// Same `data`/`version` contract as MessageMindMap.
model CaseMindMap {
  id                  String    @id @default(uuid())
  caseId              String    @unique
  data                Json
  version             Int       @default(1)
  /// Case.readySetFingerprint as of the build — which documents this map was built from.
  readySetFingerprint String?
  /// How many READY documents it was built from (Studio's "From 5 documents").
  documentCount       Int       @default(0)
  /// Exactly which documents it was built from (READY, not archived) — so the Stale badge can
  /// say what changed ("2 added, 1 removed") and a map that isn't rebuilt can drop citations to
  /// removed ones. The fingerprint above only says *that* the set changed.
  documentIds         String[]  @default([])
  /// Set when the case's last document was removed or archived: the map was built entirely from
  /// documents that are no longer in the case, so it's hidden rather than shown (Studio/Terminal
  /// treat it as no map). Kept, with its versions, rather than deleted; the next build clears it.
  retiredAt           DateTime?
  /// Last auto/regenerate build. Expanding doesn't move it — see MessageMindMap.createdAt.
  generatedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  case      Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  revisions MindMapRevision[]
}

model MessageRelatedCases {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Citation ranking for one assistant reply (src/utils/citation-rank.ts): per Library href, how
// relevant the cited authority is to the USER's message. A side table, never written into
// Message.content, so the saved answer stays immutable and a re-rank rewrites nothing. The
// ranking runs after chat:done, so a message briefly has none and its links show neutral.
model MessageCitationRanking {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Restored after the tenant-implementation merge dropped the model declaration while its
// migration (20260825153126_) stayed applied — see ChatRepo's audio-overview methods.
// An Audio Overview script and its recording. Two owners, exactly one per row (a CHECK in the
// migration): a chat message (`messageId`) when a lawyer asked for one in chat or Studio, or the
// case (`caseId`) when the case analysis wrote it (AudioOverviewSvc.generateForCase). Rendering and
// the history list work on the row id, so both kinds go through the same path.
model MessageAudioOverview {
  id          String               @id @default(uuid())
  messageId   String?              @unique
  caseId      String?
  turns       Json
  voiceHostA  String
  voiceHostB  String
  audioFileId String?
  audioStatus AudioOverviewStatus?
  // Jev's verdict per script turn (see audio-overview-jev.ts / USE_JEV_AUDIO_OVERVIEW) — null
  // when the check never ran or found nothing checkable; a turn Jev couldn't check has no entry.
  checks      Json?
  // Cumulative start second of each turn within the rendered audio (see turnStartTimes in
  // audio-overview-render.ts) — number[], one entry per `turns` element, index-aligned. Null
  // until audioStatus reaches COMPLETED (set alongside audioFileId); the frontend's line-by-line
  // highlight/auto-scroll has nothing to sync to before then.
  turnTimings Json?
  // Per turn, where each of its sentences starts in the rendered audio (see
  // markTimingsForTurn in audio-overview-render.ts, from Polly's sentence speech marks) —
  // { time, start, end }[][], index-aligned with `turns`; start/end are string indices into
  // that turn's text. Set alongside turnTimings; null on overviews rendered before it existed.
  sentenceTimings Json?
  // Same shape as sentenceTimings, per word (Polly's word speech marks) — the player fills the
  // active turn in word by word. Null on overviews rendered before it existed.
  wordTimings Json?
  createdAt   DateTime             @default(now())

  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  audioFile File?    @relation(fields: [audioFileId], references: [id])

  @@index([caseId])
}

// The legal/legal_uk "how I reached this answer" trace — see
// docs/handoffs/handoff-legal-reasoning-trace-integration-2026-08-28.md (chat-wonder-v2-api).
// Absent for many messages by design (no tool calls that turn, or silent generation
// failure on chat-wonder's side) — its absence is not itself an error condition here.
model MessageReasoning {
  id              String   @id @default(uuid())
  messageId       String   @unique
  reasoning       String   @db.Text
  citationReasons Json
  createdAt       DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Raw decision-record output for one assistant turn, exactly as chat-wonder returned it after
// its own verification pass (anchors matched, citation links checked, evidence resolved) —
// see legal_decisions.py. Kept per-message (unlike DecisionRecord below) so the turn that
// produced a given record is always recoverable even after DecisionRecordSvc promotes/updates
// the case-level rows.
model MessageDecisionRecord {
  id           String   @id @default(uuid())
  messageId    String   @unique
  records      Json
  verification Json
  createdAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// A generate_legal_document/draft_pleading tool call's rendered output — see #71. Rendered
// synchronously in persistAssistantTurn (unlike MessageAudioOverview's audio, this is fast
// enough not to need a queue/poll flow), so `file` is already resolvable by the time this
// row's message is first returned from listMessagesByConsultation.
model MessageGeneratedDocument {
  id           String   @id @default(uuid())
  messageId    String   @unique
  fileId       String
  documentType String?
  documentName String?
  createdAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])
}

// Persisted counterpart of the live-only "[TRACE]" research/verification steps shown while a
// reply is generating (ResearchTraceList on the frontend; streamChatWonderMessage's [TRACE]
// handling here) — kept per-message, same pattern as MessageReasoning/MessageDecisionRecord, so
// refreshing a case still shows how a turn's answer was checked, not only its final text.
// Absent for turns that made no tool calls — that's the normal case, not an error.
model MessageResearchSteps {
  id        String   @id @default(uuid())
  messageId String   @unique
  steps     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// The customer-facing explanation log (the Terminal's "trace" pane): one row per plain-language
// event chat-wonder emitted while answering a turn. Keyed by consultation and turn, never by
// session — a consultation gets a new chat-wonder session whenever the old one expires, and on a
// shared case several users' turns share one. `turnId` is the user Message that asked (the same
// id sent to chat-wonder as trace_turn_id); `userId` is who asked, nullable so removing a user
// keeps the log. The name shown beside an event is joined from User at read time, never stored.
// `seq` is a separate autoincrement column: race-free ordering across concurrent collectors, and
// the "everything after this" cursor for resuming a poll. Order by it, never by id or createdAt
// (createdAt is the event's own timestamp, so two events can share one).
model ConsultationTraceEvent {
  id             String   @id @default(uuid())
  // Insertion order, race-free across concurrent collectors, and the "everything after this" cursor
  // the pane polls with. Not the primary key, so ids stay uuids like every other model.
  seq            Int      @default(autoincrement())
  // Null for a run that belongs to a pane (witness scoring, case reconstruction...) and not to a chat.
  consultationId String?
  caseId         String?
  organizationId String?
  // What produced this run: "chat" for a question, otherwise the pane's generation (TRACE_SOURCES in
  // trace.constants.ts). Runs are numbered per source ("Witness scoring 2"), and the pane filters by it.
  source         String   @default("chat")
  turnId         String
  userId         String?
  // The chat-wonder session that emitted it. Informational — it changes within one consultation.
  sessionId      String
  type           String
  summary        String   @db.Text
  createdAt      DateTime @default(now())

  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([consultationId, seq])
  @@index([caseId, turnId, seq])
  @@index([caseId, createdAt])
  @@index([caseId, source])
  @@index([userId])
}

enum DecisionStatus {
  ACTIVE
  DISPUTED
  SUPERSEDED
}

// Case-level Decision Record (differentiation program, Phase 1) — the "Why?" behind one
// conclusion in a legal answer: the rule applied, the evidence for and against, the
// alternative reading considered and rejected, how it was weighted, and what fact would
// change it (payload shape: legal_decisions.py's audited record). Promoted from
// MessageDecisionRecord by DecisionRecordSvc.promote whenever a legal turn on a case-linked
// consultation produces one, and registered as a DECISION CaseGraphNode with SUPPORTS/
// CONTRADICTS CaseEdges to the DOCUMENT nodes its evidence references — see
// docs/plans/differentiation-program.md Workstream A. `authorUserId` is null for every
// AI-generated row (mirrors CaseFinding's AI-authored convention); a lawyer disputing a
// record flips `status` to DISPUTED rather than editing or deleting it, so the original
// AI reasoning stays visible alongside the disagreement.
model DecisionRecord {
  id              String         @id @default(uuid())
  caseId          String
  sourceMessageId String?
  anchor          String         @db.Text
  payload         Json
  status          DecisionStatus @default(ACTIVE)
  authorUserId    String?
  disputeNote     String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, status])
}

// ── Case Theories & Annotations (differentiation program, Phase 2 — Workstream B) ──────────
// See docs/plans/differentiation-program.md. A theory of the case is a first-class, attributed
// object: several lawyers can hold different theories of the same case side by side (never
// merged — TheoryDiffSvc reconciles by naming the deciding evidence, not by picking a winner).
// `authorUserId: null` marks an AI-proposed starting point (CaseTheorySvc.propose), same
// AI-authored convention as DecisionRecord/CaseFinding — a lawyer adopts one by forking it
// (forkedFromId) into their own authored copy, never by editing the AI's draft in place.
enum TheoryStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model CaseTheory {
  id           String       @id @default(uuid())
  caseId       String
  authorUserId String?
  title        String
  thesis       String       @db.Text
  status       TheoryStatus @default(DRAFT)
  forkedFromId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  case          Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  claims        TheoryClaim[]
  assumptions   TheoryAssumption[]
  openQuestions TheoryOpenQuestion[]

  @@index([caseId])
  @@index([caseId, authorUserId])
}

enum TheoryStance {
  ASSERTS
  DENIES
}

// `graphNodeId` optionally links this claim to an existing CaseGraphNode (typically a CLAIM,
// FINDING or DOCUMENT) — when set, CaseTheorySvc.addClaim mirrors it into a CaseEdge from the
// theory's own THEORY node (SUPPORTS for ASSERTS, CONTRADICTS for DENIES) so the claim shows up
// in the Mind Map/citation-map with no dedicated UI of its own, the same trick DecisionRecord
// uses for its evidence links.
model TheoryClaim {
  id          String       @id @default(uuid())
  theoryId    String
  statement   String       @db.Text
  stance      TheoryStance
  graphNodeId String?
  createdAt   DateTime     @default(now())

  theory CaseTheory @relation(fields: [theoryId], references: [id], onDelete: Cascade)

  @@index([theoryId])
}

model TheoryAssumption {
  id        String   @id @default(uuid())
  theoryId  String
  statement String   @db.Text
  createdAt DateTime @default(now())

  theory CaseTheory @relation(fields: [theoryId], references: [id], onDelete: Cascade)

  @@index([theoryId])
}

model TheoryOpenQuestion {
  id        String   @id @default(uuid())
  theoryId  String
  question  String   @db.Text
  createdAt DateTime @default(now())

  theory CaseTheory @relation(fields: [theoryId], references: [id], onDelete: Cascade)

  @@index([theoryId])
}

// Cached result of TheoryDiffSvc.diff for one unordered pair of theories — regenerated on
// demand (never silently merged into either theory). theoryAId/theoryBId are always stored with
// the lexicographically smaller id first so a lookup works regardless of argument order.
model TheoryDiff {
  id        String   @id @default(uuid())
  caseId    String
  theoryAId String
  theoryBId String
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([theoryAId, theoryBId])
  @@index([caseId])
}

enum AnnotationTargetType {
  NODE
  EDGE
  DECISION
  CHUNK
}

enum AnnotationKind {
  NOTE
  DISPUTE
  ALTERNATIVE_READING
}

// A comment/dispute/alternative-reading attached to any case element — a CaseGraphNode, a
// CaseEdge, a DecisionRecord, or a document chunk. `authorUserId: null` marks one written by the
// system itself (e.g. DecisionRecordSvc.dispute writes a DISPUTE annotation automatically
// alongside flipping the record's status, so the note always has a durable, commentable home
// even for a lawyer who never opens a general annotation UI).
model Annotation {
  id           String               @id @default(uuid())
  caseId       String
  authorUserId String?
  targetType   AnnotationTargetType
  targetId     String
  kind         AnnotationKind       @default(NOTE)
  body         String               @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, targetType, targetId])
}

enum AudioOverviewStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// AUTO: generated from the conversation, kept current as the topic develops.
/// PROVISIONAL: a stand-in (e.g. for a gibberish first message), replaced by the next real one.
/// USER: set or renamed by the user — the AI never touches it.
enum ConsultationTitleSource {
  AUTO
  PROVISIONAL
  USER
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageReplyStatus {
  PENDING
  DONE
  FAILED
  // The user pressed Stop while the reply was still generating — see ChatSvc.cancelChatGeneration.
  CANCELLED
}

model ConsultationInvite {
  id             String   @id @default(uuid())
  consultationId String
  createdBy      String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model ConsultationParticipant {
  consultationId String
  userId         String
  joinedAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([consultationId, userId])
}

// ── Case Management ────────────────────────────────────────────────────────────

enum CaseStatus {
  ACTIVE
  ARCHIVED
}

// Which side the lawyer acts for, in the findings prompt's burden terms: CLAIMANT brought the case
// (claimant, applicant, appellant, the prosecution), RESPONDENT defends it (respondent, defendant,
// the accused).
enum ClientSide {
  CLAIMANT
  RESPONDENT
}

model Case {
  id                    String     @id @default(uuid())
  traceEvents           ConsultationTraceEvent[]
  // Who created the case — attribution only, never access on its own (see CaseAccess). Nullable
  // so deleting that account leaves the case with its organization; createdByName keeps the
  // name to show after that.
  userId                String?
  createdByName         String?
  organizationId        String?
  // Set on a creator's portfolio copy, made when they leave the organization the original
  // stays in (see CaseCopySvc). No foreign key — the original may be deleted later.
  copiedFromCaseId      String?
  copiedFromOrgName     String?
  copiedAt              DateTime?
  caseName              String
  actionType            String?
  jurisdiction          String?
  // Constrained (England and Wales / Scotland / Northern Ireland) selector for which UK legal
  // system applies to this case — distinct from `jurisdiction` above (a free-text court/venue
  // field) and from Tenant.code (the PH/UK deployment-region boundary, see CONTEXT.md). Only
  // meaningful for UK-tenant organizations; left null for PH.
  ukJurisdiction        String?
  language              String     @default("en")
  notes                 String?    @db.Text
  lastRefreshedAt       DateTime?
  // Archiving is a pure visibility flag — an ARCHIVED case behaves identically to an ACTIVE one
  // everywhere else (documents, chat, auto-refresh, CaseAccess); it only changes which of the
  // Case Portfolio's two tabs (Active/Archived) the case shows up in. See CaseRepo.list's status
  // param and CaseRepo.setStatus.
  status                CaseStatus @default(ACTIVE)
  // A confidential matter (#346): reachable only by the organization's OWNER and people holding a
  // CaseAccess grant — plain membership, org ADMIN included, no longer opens it, and it's left out
  // of every listing for everyone else (see CaseAccess). Off by default.
  confidential          Boolean    @default(false)
  // Hash of the sorted READY document id set as of the last caseRefresh (manual or automatic) —
  // lets the post-extraction auto-trigger (queues/case-post-extraction.ts) skip a redundant
  // Chat Wonder run when the READY set hasn't actually changed (e.g. a same-file re-upload, or
  // a delete immediately followed by a re-add that nets out to the same set). Null until the
  // first refresh runs.
  readySetFingerprint   String?
  // When the Citation Map's adverse-citation sweep last finished (AdverseSweepSvc). Null until
  // the first sweep — the library badge reads "Pending" until then.
  adverseSweptAt        DateTime?
  // Which FINDINGS_FORMAT_VERSION (case-finding.constants.ts) the case's AI findings were last
  // generated with. Null for cases whose findings predate the stamp. Opening the Terminal on an
  // older one queues a findings-only regeneration (CaseFindingAiSvc.scheduleIfOutdated).
  findingsFormatVersion Int?
  // Which side the lawyer acts for — "this case" in the findings prompt means this side's case.
  // Null when the lawyer hasn't said; the prompt then keeps its claimant framing. Changing it
  // clears findingsFormatVersion so the findings regenerate from the new side (CaseSvc.update).
  clientSide            ClientSide?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user                 User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization         Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  documents            Document[]
  parties              Party[]
  consultations        Consultation[]
  transcriptions       Transcription[]
  events               Event[]
  timelineEvents       CaseTimelineEvent[]
  risks                CaseRisk[]
  evidenceMatrix       EvidenceMatrixItem[]
  contradictions       EvidenceContradiction[]
  missingEvidence      CaseMissingEvidence[]
  factPairChecks       FactPairCheck[]
  citationChecks       CitationCheck[]
  authorities          CaseAuthority[]
  deadlines            ProceduralDeadline[]
  procedureItems       ProcedureItem[]
  accesses             CaseAccess[]
  auditEvents          AuditEvent[]
  findings             CaseFinding[]
  witnesses            Witness[]
  damageClaims         DamageClaim[]
  damageClaimDismissals DamageClaimDismissal[]
  claims               CaseClaim[]
  citationGrounds      CitationGround[]
  adverseHits          AdverseCitationHit[]
  reconstruction       CaseReconstruction?
  reconstructionEvents CaseReconstructionEvents?
  redTeamAssessment    RedTeamAssessment?
  audioOverviews       MessageAudioOverview[]
  graphNodes           CaseGraphNode[]
  graphEdges           CaseGraphEdge[]
  edges                CaseEdge[]
  decisionRecords      DecisionRecord[]
  theories             CaseTheory[]
  theoryDiffs          TheoryDiff[]
  briefExports         CaseBriefExport[]
  views                CaseView[]
  terminalWorkspaces   TerminalWorkspace[]
  annotations          Annotation[]
  outlooks             CaseOutlook[]
  mindMap              CaseMindMap?
  changeSummaries      CaseChangeSummary[]
  manualEdits          CaseManualEdit[]

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([copiedFromCaseId])
}

model Party {
  id          String  @id @default(uuid())
  // On a portfolio copy (see CaseCopySvc): the party in the original case this was copied
  // from, so the copy can later be compared with the original item by item. No foreign key.
  copiedFromId String?
  caseId      String
  name        String
  designation String
  // Lawyer-entered free text shown under the party name (e.g. "Rep. by Hollis & Marr").
  // Never AI-written.
  descriptor  String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ── Case Documents ───────────────────────────────────────────────────────────

model Document {
  id               String    @id @default(uuid())
  // On a portfolio copy (see CaseCopySvc): the document in the original case this was copied
  // from, so the copy can later be compared with the original item by item. No foreign key.
  copiedFromId String?
  userId           String
  organizationId   String
  caseId           String?
  consultationId   String?
  messageId        String?
  name             String
  fileId           String?
  documentType     String?
  category         String?
  fileSize         Int?
  mimeType         String?
  ragStatus        RagStatus @default(PENDING)
  language         String    @default("en")
  pageCount        Int?
  extractionMethod String?
  ocrAttempted     Boolean   @default(false)

  // Lawyer-curated subset of a case's Documents shown in the Case Brief export's Exhibit list —
  // not every uploaded document is an Exhibit just by being uploaded. See CONTEXT.md's Exhibit entry.
  isExhibit            Boolean   @default(false)
  // Set once WitnessExtractSvc has read this document, so the automatic post-extraction witness
  // pass only ever sends new documents to the model — a witness the lawyer deleted is never
  // re-created from a document that was already read.
  witnessesExtractedAt DateTime?
  // Same idea for the damages pass (DamagesExtractSvc): set once it has read this document.
  damagesExtractedAt   DateTime?
  // Archiving is a pure visibility flag, same as Case.status — an ARCHIVED document stays fully
  // intact (chunks, RAG grounding, metadata, relationships) and is only hidden from the active
  // document view by default. See DocumentRepo.list's status param and DocumentRepo.setStatus.

  status    DocumentStatus @default(ACTIVE)
  createdAt DateTime       @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case               Case?               @relation(fields: [caseId], references: [id])
  consultation       Consultation?       @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  message            Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  file               File?               @relation(fields: [fileId], references: [id])
  chunks             CaseDocumentChunk[]
  extractedWitnesses Witness[]
  extractedDamages   DamageClaim[]

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([caseId])
  @@index([caseId, status])
  @@index([consultationId])
  @@index([messageId])
}

enum RagStatus {
  PENDING
  READY
  FAILED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

// One row per Case Brief render — every call to CaseBriefExportSvc.export(), preview or
// download alike (no distinction between the two; a lawyer opening the preview modal is still
// "generating a brief" as far as this history is concerned). `file` is the actual rendered
// artifact in S3; this row is what makes it findable/listable per case, since File itself has no
// caseId and is shared across many unrelated purposes (avatars, transcriptions, audio, ...).
// When each user last opened each case (Workspace, Terminal or the case detail page) — shown as
// "Last opened" in Case Portfolio. Per user, not per case: a Case is a shared organization
// resource, and a colleague opening it shouldn't change when *you* last looked at it. One row per
// (case, user), upserted on open. Deliberately separate from Case.updatedAt ("Last updated"),
// which tracks real changes/activity rather than views.
model CaseView {
  caseId       String
  userId       String
  lastOpenedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
  @@index([userId])
}

model CaseBriefExport {
  id        String   @id @default(uuid())
  caseId    String
  format    String
  fileId    String
  userId    String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([caseId])
}

// Case Document chunk + embedding store (ADR 0008/0010) — distinct from legal-rag's externally-
// owned `document_chunks` table above; this one belongs to this app and holds chunks extracted
// from user-uploaded Case Documents. `embedding` is `Unsupported` because Prisma Client can't
// model pgvector natively — read/write it via raw SQL (see CaseDocumentChunkRepo), same pattern
// legal-rag already uses for its own vector column.
model CaseDocumentChunk {
  id             String                       @id @default(uuid())
  caseDocumentId String
  chunkIndex     Int
  chunkText      String
  charCount      Int
  pageNumber     Int?
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  caseDocument Document @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)
  // HNSW cosine index on embedding is in SQL (Prisma cannot declare pgvector opclasses):
  // CaseDocumentChunk_embedding_hnsw_idx — see 20260820133000_add_case_document_chunk_embedding_hnsw
  // HNSW cosine index on embedding is in SQL (Prisma cannot declare pgvector opclasses):
  // CaseDocumentChunk_embedding_hnsw_idx — see 20260820133000_add_case_document_chunk_embedding_hnsw

  @@index([caseDocumentId])
}

// ── Legal Source Analysis Cache ───────────────────────────────────────────────

model LegalSourceAnalysisCache {
  id                String   @id @default(uuid())
  rawKeyword        String
  normalizedKeyword String
  tenantId          String
  title             String
  markdownContent   String   @db.Text
  rawResponse       String   @db.Text
  sourceUrl         String?
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Same keyword can be cached separately per tenant — a UK org's "unfair dismissal"
  // query must never be served the PH-analyzed cache entry for the same normalized keyword.
  @@unique([normalizedKeyword, tenantId])
}

// ── Law (juris.ph write-through cache) ────────────────────────────────────────
//
// One row per juris.ph document (jurisSourceId is juris.ph's deterministic UUIDv5, and the
// same id whether the row arrived via search or browse). LawSvc.search is local-first —
// it searches these rows and only calls juris.ph on a miss; LawSvc.browse proxies juris.ph's
// facet scroll. Both write through every returned item we don't already have. `tenantId`
// is the legal system the law belongs to, resolved from the *source* (juris.ph ⇒ PH),
// never from the caller. `rawJson` keeps the verbatim juris.ph item as a backstop; every
// other column is projected from it so the fallback query and the admin table can read
// it without parsing JSON.
//
// The `detail*` columns below hold the fuller juris.ph `retrieve` payload (sections,
// reasoning, citations, ...). They're populated lazily by LawSvc.getDocument: null until the
// first time that document's detail page is opened, then filled and never re-fetched.
// `detailFetchedAt` is the single "detail is complete" flag — check it, not individual fields.
model Law {
  id            String      @id @default(uuid())
  jurisSourceId String      @unique
  category      LawCategory
  tenantId      String

  // Relevance of this law to the most recent query that surfaced it — updated on
  // re-search, the only field a dedup hit touches (see LawSvc.search).
  score Float?

  title String // case_title (jurisprudence) | title (republic-acts)
  year  Int?
  tags  String[]

  // jurisprudence only
  caseNumber      String?
  caseType        String?
  division        String?
  ponente         String?
  decisionDate    DateTime?
  facts           String?   @db.Text
  disposition     String?   @db.Text
  legalRulesCited String[]

  // republic-acts only
  raNumber String?
  summary  String? @db.Text

  jurisUrl  String
  pdfUrl    String?
  sourceUrl String?
  rawJson   Json

  // ── lazily-fetched detail (juris.ph retrieve) — see model comment ──
  detailFetchedAt DateTime?
  keywords        String[]

  // Verbatim document text, PDF-extracted from pdfUrl/sourceUrl (see law-fulltext.ts) — juris.ph
  // itself exposes no full-text endpoint, only the summary fields above. fullTextFetchedAt is
  // stamped on every attempt, success or failure, so a document with no recoverable text (no
  // source url, unreachable PDF, scanned image) isn't re-fetched on every view.
  fullText          String?   @db.Text
  fullTextFetchedAt DateTime?

  // republic-acts detail
  sections                 Json?
  keyProvisions            String[]
  dateEnacted              String?
  legislativeAgendaPurpose String?  @db.Text
  affectedLawsAmendments   String?  @db.Text
  principalAuthors         String?
  coAuthors                String?

  // jurisprudence detail
  proceduralHistory     String?  @db.Text
  courtReasoning        String?  @db.Text
  legalIssues           String[]
  parties               Json?
  judges                Json?
  sanctionsAndPenalties Json?
  relatedCasesCited     String[]
  citedGrNumbers        String[]
  citedRaNumbers        String[]

  // Set once citation extraction has been attempted for this decision (successfully or not) —
  // distinguishes "genuinely cites nothing we could find" from "never tried," so the Citation
  // Map never silently re-runs a completed (if empty) extraction. See CitationExtractionSvc.
  citationsExtractedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  citedFrom      CitationEdge[]  @relation("CitedFrom")
  citedTo        CitationEdge[]  @relation("CitedTo")
  citationChecks CitationCheck[] @relation("ResolvedLaw")
  authorities    CaseAuthority[]

  @@index([category, tenantId])
  @@index([year])
}

// ── Citation Map ──────────────────────────────────────────────────────────────
// Shared, tenant-scoped cache of "Law A cites Law B" — extracted once per Law via LLM
// (CitationExtractionSvc) and reused by every case/tenant that ever explores that decision,
// since a case's citations don't change once the decision is final. See docs/plan for the
// full design: this is a v1 for Philippine jurisprudence, no full-text source exists upstream
// (juris.ph is search-only), so extraction is best-effort against a fetched/parsed PDF with a
// summary fallback — `confidence` on the resolved `toLaw` reflects that.
model CitationEdge {
  id             String            @id @default(uuid())
  fromLawId      String
  toLawId        String?
  toRawReference String? // best-effort case number/title when resolution to a Law row fails
  toRawTitle     String?
  treatment      CitationTreatment
  // Populated for UK edges from the UK Legal MCP's citations_network grouping ("case",
  // "legislation", "si", "eu") — that source gives no judicial-treatment signal (see
  // `treatment`'s comment on this model's usage in CitationExtractionSvc vs.
  // UkCitationNetworkSvc), so this carries the distinction it actually supports instead. Left
  // null for PH edges, which have no equivalent typing.
  citationType   String?
  excerpt        String?           @db.Text
  confidence     Float? // resolution confidence for toLawId; null when unresolved
  createdAt      DateTime          @default(now())

  fromLaw Law  @relation("CitedFrom", fields: [fromLawId], references: [id], onDelete: Cascade)
  toLaw   Law? @relation("CitedTo", fields: [toLawId], references: [id], onDelete: SetNull)

  @@index([fromLawId])
  // The adverse-citation sweep looks edges up by the authority they point at.
  @@index([toLawId])
}

enum CitationTreatment {
  FOLLOWED
  DISTINGUISHED
  ABANDONED
  OVERRULED
  CITED
}

enum LawCategory {
  JURISPRUDENCE
  REPUBLIC_ACT
}

// ── LawBrowsePage (juris.ph browse-page cache) ────────────────────────────────
//
// One row per (facet filter + pagination cursor) that has been fetched from juris.ph's
// scroll API, capturing that page's exact contents and order (`jurisIds`, all written
// through to Law). LawSvc.browse serves a page straight from here — no juris.ph call —
// when the row exists (first pages age out after BROWSE_CACHE_TTL_MS; deeper pages are
// historical and never expire). `pageKey` is sha256(filterKey + cursor) so the unique
// index stays small even when a cursor's `seenIds` list grows large.
model LawBrowsePage {
  id          String   @id @default(uuid())
  pageKey     String   @unique
  filterKey   String
  isFirstPage Boolean
  jurisIds    String[]
  hasMore     Boolean
  nextCursor  String?
  fetchedAt   DateTime @default(now())
}

// ── Bookmarks ─────────────────────────────────────────────────────────────────

model Bookmark {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  itemId         String
  title          String
  reference      String?
  type           BookmarkType
  url            String?
  aiSummary      String?      @db.Text
  doctrine       String?      @db.Text
  facts          String?      @db.Text
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Uniqueness moves to the org: bookmarks are a shared resource, so two members bookmarking
  // the same item should dedupe at the organization level, not per-user.
  @@unique([organizationId, itemId])
  @@index([userId])
  @@index([organizationId])
}

enum BookmarkType {
  case
  source
}

// ── Calendar ──────────────────────────────────────────────────────────────────

model CalendarWatchChannel {
  id         String   @id @default(uuid())
  channelId  String   @unique
  resourceId String
  userId     String
  expiration BigInt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                   String    @id @default(uuid())
  // On a portfolio copy (see CaseCopySvc): the event in the original case this was copied
  // from, so the copy can later be compared with the original item by item. No foreign key.
  copiedFromId String? @map("copied_from_id")
  userId               String
  organizationId       String    @map("organization_id")
  title                String
  type                 String    @default("Meeting")
  dateTime             DateTime  @map("date_time")
  endDateTime          DateTime? @map("end_date_time")
  clientEmail          String?   @map("client_email")
  notes                String?   @db.Text
  status               String    @default("pending")
  googleLink           String?   @map("google_link")
  googleEventId        String?   @map("google_event_id")
  // Google's `updated` time for its copy of this event, as last written or applied by the sync
  // (GoogleCalendarSyncSvc / GoogleCalendarPullSvc). A Google change newer than this is new;
  // anything else is the sync's own write echoing back.
  googleUpdatedAt      DateTime? @map("google_updated_at")
  // When the app last changed something the Google copy shows (title, time, notes, status, ...)
  // that hasn't reached Google yet; cleared by a successful push. The pull compares it with a
  // Google edit's time so the newer edit wins — `updatedAt` can't, since bookkeeping writes
  // (reminder sent, acknowledged) bump it too.
  googleDirtyAt        DateTime? @map("google_dirty_at")
  reminderLeadMinutes  Int?      @map("reminder_lead_minutes")
  lastReminderSentAt   DateTime? @map("last_reminder_sent_at")
  lawyerAcknowledgedAt DateTime? @map("lawyer_acknowledged_at")
  clientFeedback       String?   @map("client_feedback") @db.Text
  caseId               String?   @map("case_id")
  dateSource           String?   @map("date_source")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([googleEventId, userId], map: "events_google_event_id_user_id_key")
  @@index([userId])
  @@index([organizationId])
  @@index([caseId])
  @@map("events")
}

// A free-form note anchored to one calendar day — distinct from Event/Appointment
// in that it has no start/end time (see CONTEXT.md's "Note" glossary entry).
model Note {
  id             String   @id @default(uuid())
  userId         String
  organizationId String   @map("organization_id")
  date           DateTime @map("date")
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([date])
  @@map("notes")
}

// Centralized in-app notification hub (bell icon). `organizationId` is nullable so a
// notification can outlive the user leaving an org, or be sent outside any org context
// (e.g. a system-wide alert) — always scope reads/writes by userId, treat organizationId
// as informational only. `type` mirrors Event.type: a free-form string, not a Prisma enum,
// validated at the Joi layer (see notification.validation.ts) so new categories don't need
// a migration.
model Notification {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?   @map("organization_id")
  type           String
  title          String
  message        String    @db.Text
  link           String?
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

// ── Transcription ─────────────────────────────────────────────────────────────

model Transcription {
