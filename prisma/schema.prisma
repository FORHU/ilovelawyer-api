// A legal claim/cause of action being pursued (e.g. "Breach of Contract", "Negligence") —
// distinct from DamageClaim, which is a monetary damages line item sought under one or more
// of these claims, not the legal theory itself.
model CaseClaim {
  id            String   @id @default(uuid())
