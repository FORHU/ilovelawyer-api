// One narrative per Case (not a list, unlike CaseFinding) — regenerated in place by AI on
// demand (a dedicated action, not bundled into the general Refresh, since long-form
// generation is a heavier/slower single call) and editable afterward by the lawyer.
model CaseReconstruction {
  id                String    @id @default(uuid())
  caseId            String    @unique
  narrative         String    @db.Text
  // "For the court" and "from the other side" registers (PDF's Narrative Engine window) —
  // nullable since a reconstruction generated before this field existed has narrative only.
  narrativeCourt    String?   @db.Text
  narrativeOpposing String?   @db.Text
  // Qualitative "what this doesn't explain" list — deliberately not a coverage percentage,
  // which isn't honestly groundable given the prompt only sees a sampled excerpt pack.
  gaps              String[]  @default([])
  // Claim-level attribution for `narrative` only (the General register — the one that isn't
  // reframed/redacted like Court/Opposing) — same shape and matching approach as
  // RedTeamAssessment.claims (see extractReconstructionClaims): a verbatim-substring quote
  // matched back onto the text at render time. Cleared whenever `narrative` is hand-edited
  // (see CaseReconstructionSvc.update) since a stale claim would otherwise mismatch silently.
  claims            Json?
  // Audio narration (General/narrative register only) — async AWS Polly job, same
  // start-job/poll-status shape as Transcription's AWS Transcribe integration.
  audioFileId       String?
  audioJobName      String?
  audioStatus       String?
  audioStaleAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  audioFile File? @relation(fields: [audioFileId], references: [id])
}

// The "Red Team" panel — an adversarial threat assessment generated from the case's own
// structured findings (Legal Issues, Weaknesses, Contradictions, Witnesses, Damages), not
// from raw document text. One assessment per case, regenerated in place. No manual edit,
// unlike CaseReconstruction — this is meant to be read as opposing counsel's own commentary,
// not something the lawyer rewrites in their own voice.
model RedTeamAssessment {
  id        String   @id @default(uuid())
  caseId    String   @unique
  content   String   @db.Text
  // Claim-level attribution (RedTeamClaim[] from red-team-claims-parse.ts) — which sentences
  // are grounded in a specific case-data item vs. AI inference vs. flagged unsupported. Matched
  // back onto `content` at render time (components/shared/attributed-text.tsx); `content`
  // itself is never modified, so this stays valid even across future edits/regenerations.
  claims    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ── Case Graph (Phase A: dependency tracking + staleness, no auto-recompute) ───────────────
//
// Phase A proved one real edge — CaseTimelineEvent -> ProceduralDeadline — with just
// TIMELINE_EVENT/PROCEDURAL_DEADLINE. Phase B (this) registers the rest of a case's canonical,
// lawyer/AI-authored entities as nodes so panels beyond the Terminal (e.g. Mind Map, Evidence
// Matrix) can key off one shared identity per entity instead of re-deriving it, and so a future
// edge between any two of them costs nothing beyond a service call. WITNESS/DAMAGE_CLAIM/
// FINDING/CLAIM are actively registered (see WitnessSvc/DamageClaimSvc/CaseFindingSvc/
// CaseClaimSvc — ensureNode on create, markStale on update). DOCUMENT and PARTY are declared
// for a complete vocabulary but not yet wired: Document's creation path is shared across
// case/consultation/no-case uploads with no single safe insertion point, and Party is fully
// replaced (delete-all + recreate) on every Case edit, which can't hold a stable refId across
// edits — both need their own follow-up once there's a real edge that needs them. Linking is
// always explicit (a service call), never inferred — matches this codebase's existing
// hand-wired reactive style (CaseRefreshSvc, scheduleCasePostExtraction), not a generic
// Prisma-hook/event-bus mechanism.
enum CaseGraphNodeType {
  TIMELINE_EVENT
  PROCEDURAL_DEADLINE
  WITNESS
  DOCUMENT
  PARTY
  DAMAGE_CLAIM
  FINDING
  CLAIM
}

model CaseGraphNode {
  id          String            @id @default(uuid())
  caseId      String
  nodeType    CaseGraphNodeType
  refId       String
  staleAt     DateTime?
  staleReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  outgoingEdges     CaseGraphEdge[] @relation("CaseGraphEdgeSource")
  incomingEdges     CaseGraphEdge[] @relation("CaseGraphEdgeTarget")
  outgoingCaseEdges CaseEdge[]      @relation("CaseEdgeSource")
  incomingCaseEdges CaseEdge[]      @relation("CaseEdgeTarget")

  @@unique([nodeType, refId])
  @@index([caseId])
}

model CaseGraphEdge {
  id           String   @id @default(uuid())
  caseId       String
  sourceNodeId String
  targetNodeId String
  kind         String
  createdAt    DateTime @default(now())

  case   Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  source CaseGraphNode @relation("CaseGraphEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target CaseGraphNode @relation("CaseGraphEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, kind])
  @@index([caseId])
  @@index([targetNodeId])
}

// Evidentiary/argumentation links between CaseGraphNode entities (the canonical node registry
// from Phase B, above) — "this witness statement CONTRADICTS that timeline event", "this
// document PROVES this claim". Deliberately a separate table from CaseGraphEdge: that one is
// Phase A/B's dependency+staleness engine with a free-form `kind`, walked only for recompute
// closure; this one backs the Mind Map/citation-map UI, has a closed relation vocabulary the
// UI renders distinctly, and carries per-edge metadata (e.g. the citation/quote backing a
// CITES link). A deleted node cascades here at the FK level, and CaseEdgeSvc.archiveForNode
// snapshots the row into CaseEdgeArchive first — see that service for why this is an explicit
// call plus a DB trigger rather than either alone.
enum CaseEdgeRelationType {
  SUPPORTS
  CONTRADICTS
  CITES
  PROVES
  REFUTES
  SPONSORS
}

model CaseEdge {
  id             String               @id @default(uuid())
  caseId         String
  sourceEntityId String
  targetEntityId String
  relationType   CaseEdgeRelationType
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceEntity CaseGraphNode @relation("CaseEdgeSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity CaseGraphNode @relation("CaseEdgeTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([sourceEntityId, targetEntityId, relationType])
  @@index([caseId])
  @@index([targetEntityId])
}

// Snapshot of a CaseEdge row taken by the archive_case_edge() trigger the instant before a
// cascade delete (node removed, or its Case removed) would otherwise erase it — see the
// migration SQL for the trigger and CaseEdgeSvc for the read path. No FKs back to the live
// tables: by the time a row lands here, the entity/case it referenced may already be gone.
model CaseEdgeArchive {
  id             String               @id @default(uuid())
  caseId         String
  sourceEntityId String
  targetEntityId String
  relationType   CaseEdgeRelationType
  metadata       Json
  createdAt      DateTime
  updatedAt      DateTime
  archivedAt     DateTime             @default(now())

  @@index([caseId])
}

