// A named multi-screen workspace template (which panel lives on which physical screen, and that
// screen's arrangement mode) — see apps/web/lib/terminal/screen-presets.ts's ScreenPresetDef,
// which this mirrors field-for-field via `screens`. `userId: null` marks a system preset, global
// to every user and only ever written by the seeder (prisma/seeders/screen-preset-grouped.seeder.ts);
// otherwise it's a lawyer's own saved preset, cascade-deleted with their account.
model ScreenPreset {
  id             String   @id @default(uuid())
  userId         String?
  // System presets only — resolved through terminal.json client-side. Null on a user's own
  // preset, which has no i18n key: `name`/`description` below are shown directly instead.
  labelKey       String?
  descriptionKey String?
  // User presets: lawyer-entered text. System presets: an English fallback/admin-readable label,
  // never actually shown to a lawyer while labelKey is set.
  name           String
  description    String?  @db.Text
  // Denormalized from screens.length, so filtering by screen count doesn't need a JSON query.
  screenCount    Int
  screens        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([screenCount])
}

model CaseTimelineEvent {
  id          String         @id @default(uuid())
  // On a portfolio copy (see CaseCopySvc): the timeline entry in the original case this was copied
  // from, so the copy can later be compared with the original item by item. No foreign key.
  copiedFromId String?
  caseId      String
  title       String
  occurredOn  DateTime?
  description String?        @db.Text
  status      String         @default("pending")
  source      TimelineSource @default(LAWYER)
  documentId  String?
  chunkId     String?
