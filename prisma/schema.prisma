generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String?
  name                String?
  username            String    @unique
  role                Role      @default(USER)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  provider            String?
  googleId            String?   @unique
  googleAccessToken   String?
  googleRefreshToken  String?
  avatarId            String?
  isEmailVerified     Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  otpCode             String?
  otpExpiry           DateTime?
  emailVerificationOtp       String?
  emailVerificationOtpExpiry DateTime?

  // Signup email verification — deliberately separate from otpCode/otpExpiry
  // above (which belong to the password-reset flow) so the two one-time-code
  // flows can't clobber each other. See docs/adr/0001-email-verification-otp.md.
  emailVerificationCode       String?
  emailVerificationExpiry     DateTime?
  emailVerificationAttempts   Int       @default(0)
  emailVerificationLastSentAt DateTime?

  sessions                 Session[]
  avatar                   File?                     @relation(fields: [avatarId], references: [id])
  consultations            Consultation[]
  messages                 Message[]
  createdInvites           ConsultationInvite[]
  consultationParticipants ConsultationParticipant[]
  packageSku               PackageSku @default(SOLO)
  preferredLanguage        String     @default("en")

  cases                    Case[]
  documents                Document[]
  bookmarks                Bookmark[]
  transcriptions           Transcription[]
  calendarWatchChannels    CalendarWatchChannel[]
  events                   Event[]
  terminalWorkspaces       TerminalWorkspace[]
  organizationMemberships  OrganizationMember[]
  createdOrganizations     Organization[]        @relation("OrgCreator")
  ownedRisks               CaseRisk[]
  auditEvents              AuditEvent[]
  caseAccesses             CaseAccess[]
  integrationConnectors    IntegrationConnector[]
  deadlineConfirmations    ProceduralDeadlineConfirmation[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  refreshToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id        String    @id @default(uuid())
  filename  String?
  fileUrl   String?
  s3Key     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metaData  Json?
  users          User[]
  transcriptions Transcription[]
  caseDocuments  Document[]
}

enum Role {
  USER
  ADMIN
}

enum PackageSku {
  SOLO
  PROFESSIONAL
  ENTERPRISE
}

// ── Chat ──────────────────────────────────────────────────────────────────────

model Consultation {
  id        String   @id @default(uuid())
  userId    String
  caseId    String?
  title     String?
  createdAt DateTime @default(now())

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case         Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  messages     Message[]
  invites      ConsultationInvite[]
  participants ConsultationParticipant[]
  documents    Document[]

  @@index([userId])
  @@index([caseId])
}

model Message {
  id              String      @id @default(uuid())
  consultationId  String
  role            MessageRole
  content         String      @db.Text
  imagePreview    String?
  timestamp       DateTime?
  createdAt       DateTime    @default(now())
  userId          String?
  parentMessageId String?

  consultation Consultation     @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       Message?         @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("MessageThread")
  timeline     MessageTimeline?
  mindMap      MessageMindMap?
  relatedCases MessageRelatedCases?

  @@index([consultationId])
  @@index([userId])
  @@index([parentMessageId])
}

model MessageTimeline {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageMindMap {
  id        String   @id @default(uuid())
  messageId String   @unique
  data      Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageRelatedCases {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  user
  assistant
  system
}

model ConsultationInvite {
  id             String   @id @default(uuid())
  consultationId String
  createdBy      String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model ConsultationParticipant {
  consultationId String
  userId         String
  joinedAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([consultationId, userId])
}

// ── Case Management ────────────────────────────────────────────────────────────

model Case {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  caseName       String
  actionType     String?
  jurisdiction   String?
  language       String   @default("en")
  notes          String?  @db.Text
  lastRefreshedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  documents      Document[]
  parties        Party[]
  consultations  Consultation[]
  transcriptions Transcription[]
  events         Event[]
  timelineEvents CaseTimelineEvent[]
  risks          CaseRisk[]
  evidenceMatrix EvidenceMatrixItem[]
  contradictions EvidenceContradiction[]
  citationChecks CitationCheck[]
  deadlines      ProceduralDeadline[]
  procedureItems ProcedureItem[]
  accesses       CaseAccess[]
  auditEvents    AuditEvent[]

  @@index([userId])
  @@index([organizationId])
}

model Party {
  id          String @id @default(uuid())
  caseId      String
  name        String
  designation String

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ── Case Documents ───────────────────────────────────────────────────────────

model Document {
  id             String    @id @default(uuid())
  userId         String
  caseId         String?
  consultationId String?
  name           String
  fileId         String?
  documentType   String?
  fileSize       Int?
  mimeType       String?
  ragStatus          RagStatus @default(PENDING)
  language           String    @default("en")
  pageCount          Int?
  extractionMethod   String?
  ocrAttempted       Boolean   @default(false)
  createdAt          DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  case         Case?               @relation(fields: [caseId], references: [id])
  consultation Consultation?       @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  file         File?               @relation(fields: [fileId], references: [id])
  chunks       CaseDocumentChunk[]

  @@index([userId])
  @@index([caseId])
  @@index([consultationId])
}

enum RagStatus {
  PENDING
  READY
  FAILED
}

// Case Document chunk + embedding store (ADR 0008/0010) — distinct from legal-rag's externally-
// owned `document_chunks` table above; this one belongs to this app and holds chunks extracted
// from user-uploaded Case Documents. `embedding` is `Unsupported` because Prisma Client can't
// model pgvector natively — read/write it via raw SQL (see CaseDocumentChunkRepo), same pattern
// legal-rag already uses for its own vector column.
model CaseDocumentChunk {
  id             String                       @id @default(uuid())
  caseDocumentId String
  chunkIndex     Int
  chunkText      String
  charCount      Int
  pageNumber     Int?
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  caseDocument Document @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  @@index([caseDocumentId])
  // HNSW cosine index on embedding is in SQL (Prisma cannot declare pgvector opclasses):
  // CaseDocumentChunk_embedding_hnsw_idx — see 20260820133000_add_case_document_chunk_embedding_hnsw
}

// ── Legal Source Analysis Cache ───────────────────────────────────────────────

model LegalSourceAnalysisCache {
  id                String   @id @default(uuid())
  rawKeyword        String
  normalizedKeyword String   @unique
  title             String
  markdownContent   String   @db.Text
  rawResponse       String   @db.Text
  sourceUrl         String?
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Bookmarks ─────────────────────────────────────────────────────────────────

model Bookmark {
  id        String       @id @default(uuid())
  userId    String
  itemId    String
  title     String
  reference String?
  type      BookmarkType
  url       String?
  aiSummary String?      @db.Text
  doctrine  String?      @db.Text
  facts     String?      @db.Text
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

enum BookmarkType {
  case
  source
}

// ── Calendar ──────────────────────────────────────────────────────────────────

model CalendarWatchChannel {
  id         String   @id @default(uuid())
  channelId  String   @unique
  resourceId String
  userId     String
  expiration BigInt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                      String    @id @default(uuid())
  userId                  String
  title                   String
  type                    String    @default("Meeting")
  dateTime                DateTime  @map("date_time")
  clientEmail             String?   @map("client_email")
  notes                   String?   @db.Text
  status                  String    @default("pending")
  googleLink              String?   @map("google_link")
  googleEventId           String?   @map("google_event_id")
  lastReminderSentAt      DateTime? @map("last_reminder_sent_at")
  reminderDayBeforeSentAt DateTime? @map("reminder_day_before_sent_at")
  reminderDayOfSentAt     DateTime? @map("reminder_day_of_sent_at")
  lawyerAcknowledgedAt    DateTime? @map("lawyer_acknowledged_at")
  clientFeedback          String?   @map("client_feedback") @db.Text
  caseId                  String?   @map("case_id")
  dateSource              String?   @map("date_source")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([googleEventId, userId], map: "events_google_event_id_user_id_key")
  @@index([userId])
  @@index([caseId])
  @@map("events")
}

// ── Transcription ─────────────────────────────────────────────────────────────

model Transcription {
  id           String   @id @default(uuid())
  userId       String
  caseId       String?
  audioFileId  String?
  title        String?
  transcript   String?  @db.Text
  duration     Float?
  jobName      String?
  status       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case? @relation(fields: [caseId], references: [id])
  audioFile File? @relation(fields: [audioFileId], references: [id])

  @@index([userId])
  @@index([caseId])
}

// Legal RAG tables (documents, document_chunks, ingestion_runs) live in this same
// database but are intentionally not modeled here — they're owned by an external
// ingestion pipeline. Query them via prisma.$queryRaw (see src/repositories/legal-rag.repository.ts)
// using DATABASE_URL.

// ── Legal Terminal ────────────────────────────────────────────────────────────

enum WorkspacePreset {
  PANE_1
  PANE_2
  PANE_4
  PANE_6
}

enum TimelineSource {
  AI
  LAWYER
  CALENDAR
}

enum RiskSeverity {
  FATAL
  MAJOR
  UNVERIFIED
  MISSING_EVIDENCE
  DEADLINE
}

enum RiskStatus {
  OPEN
  CONFIRMED
  ACCEPTED
}

enum OrgRole {
  OWNER
  PARTNER
  ASSOCIATE
  PARALEGAL
  MEMBER
}

enum CasePermission {
  VIEW
  EDIT
  ADMIN
}

enum CitationValidityStatus {
  VALID
  INVALID
  UNVERIFIED
  ADVERSE
}

enum ConnectorType {
  DMS
  EMAIL
  CALENDAR
  EFILING
  LEGAL_DATABASE
}

enum ConnectorStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model TerminalWorkspace {
  id         String           @id @default(uuid())
  userId     String
  name       String
  preset     WorkspacePreset
  layoutJson Json
  isLastUsed Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseTimelineEvent {
  id          String         @id @default(uuid())
  caseId      String
  title       String
  occurredOn  DateTime?
  description String?        @db.Text
  status      String         @default("pending")
  source      TimelineSource @default(LAWYER)
  documentId  String?
  chunkId     String?
  pageNumber  Int?
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([documentId])
}

model CaseRisk {
  id          String       @id @default(uuid())
  caseId      String
  title       String
  description String?      @db.Text
  severity    RiskSeverity
  status      RiskStatus   @default(OPEN)
  ownerUserId String?
  documentId  String?
  chunkId     String?
  pageNumber  Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([ownerUserId])
}

model EvidenceMatrixItem {
  id             String   @id @default(uuid())
  caseId         String
  documentId     String
  authenticity   String   @default("unverified")
  admissibility  String   @default("unverified")
  probative      String   @default("unverified")
  originalFile   Boolean  @default(true)
  needsVerify    Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, documentId])
  @@index([caseId])
}

model EvidenceContradiction {
  id              String   @id @default(uuid())
  caseId          String
  kind            String
  leftDocumentId  String
  rightDocumentId String
  leftExcerpt     String   @db.Text
  rightExcerpt    String   @db.Text
  factKey         String
  leftValue       String
  rightValue      String
  confidence      Float    @default(0.5)
  createdAt       DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CitationCheck {
  id             String                  @id @default(uuid())
  caseId         String
  quotedText     String                  @db.Text
  citedReference String?
  sourceUrl      String?
  officialText   String?                 @db.Text
  status         CitationValidityStatus  @default(UNVERIFIED)
  notes          String?                 @db.Text
  checkedAt      DateTime                @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model ProceduralDeadline {
  id               String   @id @default(uuid())
  caseId           String
  label            String
  ruleCode         String
  triggerDate      DateTime
  computedDueDate  DateTime
  ruleSource       String
  serviceMethod    String?
  calculationNotes String   @db.Text
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  case           Case                               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  confirmations  ProceduralDeadlineConfirmation[]

  @@index([caseId])
}

model ProceduralDeadlineConfirmation {
  id         String   @id @default(uuid())
  deadlineId String
  userId     String
  confirmed  Boolean
  note       String?
  createdAt  DateTime @default(now())

  deadline ProceduralDeadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deadlineId, userId])
  @@index([deadlineId])
}

model ProcedureItem {
  id        String   @id @default(uuid())
  caseId    String
  kind      String
  label     String
  done      Boolean  @default(false)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Organization {
  id          String     @id @default(uuid())
  name        String
  packageSku  PackageSku @default(PROFESSIONAL)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy   User                   @relation("OrgCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  cases       Case[]
  connectors  IntegrationConnector[]

  @@index([createdById])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model CaseAccess {
  id         String         @id @default(uuid())
  caseId     String
  userId     String
  permission CasePermission @default(VIEW)
  createdAt  DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  caseId    String?
  actorId   String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  case  Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([actorId])
}

model JurisdictionModule {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  language  String   @default("en")
  configJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationConnector {
  id             String          @id @default(uuid())
  userId         String?
  organizationId String?
  type           ConnectorType
  status         ConnectorStatus @default(DISCONNECTED)
  configJson     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

