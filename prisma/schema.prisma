// The AI's view of where the case is heading, always as a band + confidence and never as a
// number: a percentage would read as a prediction the model cannot back up.
enum OutlookBand {
  FAVORABLE
  LEANS_FAVORABLE
  UNCERTAIN
  LEANS_UNFAVORABLE
  UNFAVORABLE
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

// Append-only: every refresh inserts a row, nothing is updated or deleted, so the history is the
// table itself (latest row = current outlook). A failed or unparseable generation writes nothing
// and the previous row stays current. See CaseOutlookAiSvc.
model CaseOutlook {
  id               String          @id @default(uuid())
  caseId           String
  band             OutlookBand
  confidence       ConfidenceLevel
  rationale        String          @db.Text
  // [{ label, direction: "HELPS" | "HURTS", sourceDocId? }] — see utils/case-outlook-parse.ts.
  // sourceDocId is only kept when it names a document on this case.
  drivers          Json
  // utils/case-outlook-fingerprint.ts — the material this outlook was built from. A run whose
  // fingerprint matches the newest row keeps it instead of asking the model again. Null on rows
  // from before the column, so their next run always writes a new row.
  inputFingerprint String?
  createdAt        DateTime        @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

