// ── AI generation locks ─────────────────────────────────────────────────────────
// Generic "is a generation currently running" marker, shared by every Chat-Wonder-backed
// Generate/Refresh/Scan action (Red Team, Case Reconstruction, Contradictions, the global
// case refresh, Mind Map, Audio Overview's script step, and PH Citation Map's per-node
// expand). Without this, a page refresh mid-generation looks idle even though the server-side
// call is still running, inviting a duplicate click. `subjectId` is deliberately not a
// relation — it's a caseId for the case-level kinds above, a Law.id for citationExpand — this
// is a generic lock, not a domain entity. See AiGenerationLockSvc.
model AiGenerationJob {
  id         String             @id @default(uuid())
  subjectId  String
  kind       String
  status     AiGenerationStatus @default(IN_PROGRESS)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  error      String?

  @@unique([subjectId, kind])
  @@index([subjectId])
}

enum AiGenerationStatus {
  IN_PROGRESS
  DONE
  FAILED
}
