generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  password                   String?
  name                       String?
  username                   String    @unique
  role                       Role      @default(USER)
  lastLoginAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  provider                   String?
  googleId                   String?   @unique
  googleAccessToken          String?
  googleRefreshToken         String?
  avatarId                   String?
  isEmailVerified            Boolean   @default(false)
  onboardingCompleted        Boolean   @default(false)
  otpCode                    String?
  otpExpiry                  DateTime?
  emailVerificationOtp       String?
  emailVerificationOtpExpiry DateTime?

  // Signup email verification — deliberately separate from otpCode/otpExpiry
  // above (which belong to the password-reset flow) so the two one-time-code
  // flows can't clobber each other. See docs/adr/0001-email-verification-otp.md.
  emailVerificationCode       String?
  emailVerificationExpiry     DateTime?
  emailVerificationAttempts   Int       @default(0)
  emailVerificationLastSentAt DateTime?

  sessions                 Session[]
  avatar                   File?                     @relation(fields: [avatarId], references: [id])
  consultations            Consultation[]
  messages                 Message[]
  createdInvites           ConsultationInvite[]
  consultationParticipants ConsultationParticipant[]
  cases                    Case[]
  documents                Document[]
  bookmarks                Bookmark[]
  transcriptions           Transcription[]
  calendarWatchChannels    CalendarWatchChannel[]
  events                   Event[]
  organizationMemberships  OrganizationMember[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  refreshToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id             String          @id @default(uuid())
  filename       String?
  fileUrl        String?
  s3Key          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  metaData       Json?
  users          User[]
  transcriptions Transcription[]
  caseDocuments  Document[]
}

enum Role {
  USER
  ADMIN
}

// ── Chat ──────────────────────────────────────────────────────────────────────

model Consultation {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  caseId         String?
  title          String?
  createdAt      DateTime @default(now())

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case           Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  messages       Message[]
  invites        ConsultationInvite[]
  participants   ConsultationParticipant[]
  documents      Document[]
  transcriptions Transcription[]

  @@index([userId])
  @@index([organizationId])
  @@index([caseId])
}

model Message {
  id              String      @id @default(uuid())
  consultationId  String
  role            MessageRole
  content         String      @db.Text
  imagePreview    String?
  timestamp       DateTime?
  createdAt       DateTime    @default(now())
  userId          String?
  parentMessageId String?

  consultation Consultation         @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       Message?             @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies      Message[]            @relation("MessageThread")
  timeline     MessageTimeline?
  mindMap      MessageMindMap?
  relatedCases MessageRelatedCases?
  documents    Document[]

  @@index([consultationId])
  @@index([userId])
  @@index([parentMessageId])
}

model MessageTimeline {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageMindMap {
  id        String   @id @default(uuid())
  messageId String   @unique
  data      Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageRelatedCases {
  id        String   @id @default(uuid())
  messageId String   @unique
  items     Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  user
  assistant
  system
}

model ConsultationInvite {
  id             String   @id @default(uuid())
  consultationId String
  createdBy      String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model ConsultationParticipant {
  consultationId String
  userId         String
  joinedAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([consultationId, userId])
}

// ── Case Management ────────────────────────────────────────────────────────────

model Case {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  caseName       String
  actionType     String?
  jurisdiction   String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  parties        Party[]
  consultations  Consultation[]
  transcriptions Transcription[]

  @@index([userId])
  @@index([organizationId])
}

model Party {
  id          String @id @default(uuid())
  caseId      String
  name        String
  designation String

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ── Case Documents ───────────────────────────────────────────────────────────

model Document {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  caseId         String?
  consultationId String?
  messageId      String?
  name           String
  fileId         String?
  documentType   String?
  fileSize       Int?
  mimeType       String?
  ragStatus      RagStatus @default(PENDING)
  createdAt      DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?               @relation(fields: [caseId], references: [id])
  consultation Consultation?       @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  message      Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  file         File?               @relation(fields: [fileId], references: [id])
  chunks       CaseDocumentChunk[]

  @@index([userId])
  @@index([organizationId])
  @@index([caseId])
  @@index([consultationId])
  @@index([messageId])
}

enum RagStatus {
  PENDING
  READY
  FAILED
}

// Case Document chunk + embedding store (ADR 0008/0010) — distinct from legal-rag's externally-
// owned `document_chunks` table above; this one belongs to this app and holds chunks extracted
// from user-uploaded Case Documents. `embedding` is `Unsupported` because Prisma Client can't
// model pgvector natively — read/write it via raw SQL (see CaseDocumentChunkRepo), same pattern
// legal-rag already uses for its own vector column.
model CaseDocumentChunk {
  id             String                       @id @default(uuid())
  caseDocumentId String
  chunkIndex     Int
  chunkText      String
  charCount      Int
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  caseDocument Document @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  @@index([caseDocumentId])
}

// ── Legal Source Analysis Cache ───────────────────────────────────────────────

model LegalSourceAnalysisCache {
  id                String   @id @default(uuid())
  rawKeyword        String
  normalizedKeyword String   @unique
  title             String
  markdownContent   String   @db.Text
  rawResponse       String   @db.Text
  sourceUrl         String?
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Bookmarks ─────────────────────────────────────────────────────────────────

model Bookmark {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  itemId         String
  title          String
  reference      String?
  type           BookmarkType
  url            String?
  aiSummary      String?      @db.Text
  doctrine       String?      @db.Text
  facts          String?      @db.Text
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Uniqueness moves to the org: bookmarks are a shared resource, so two members bookmarking
  // the same item should dedupe at the organization level, not per-user.
  @@unique([organizationId, itemId])
  @@index([userId])
  @@index([organizationId])
}

enum BookmarkType {
  case
  source
}

// ── Calendar ──────────────────────────────────────────────────────────────────

model CalendarWatchChannel {
  id         String   @id @default(uuid())
  channelId  String   @unique
  resourceId String
  userId     String
  expiration BigInt
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                      String    @id @default(uuid())
  userId                  String
  organizationId          String    @map("organization_id")
  title                   String
  type                    String    @default("Meeting")
  dateTime                DateTime  @map("date_time")
  clientEmail             String?   @map("client_email")
  notes                   String?   @db.Text
  status                  String    @default("pending")
  googleLink              String?   @map("google_link")
  googleEventId           String?   @map("google_event_id")
  lastReminderSentAt      DateTime? @map("last_reminder_sent_at")
  reminderDayBeforeSentAt DateTime? @map("reminder_day_before_sent_at")
  reminderDayOfSentAt     DateTime? @map("reminder_day_of_sent_at")
  lawyerAcknowledgedAt    DateTime? @map("lawyer_acknowledged_at")
  clientFeedback          String?   @map("client_feedback") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([googleEventId, userId], map: "events_google_event_id_user_id_key")
  @@index([userId])
  @@index([organizationId])
  @@map("events")
}

// ── Transcription ─────────────────────────────────────────────────────────────

model Transcription {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  caseId         String?
  consultationId String?
  audioFileId    String?
  title          String?
  transcript     String?   @db.Text
  duration       Float?
  jobName        String?
  status         String?
  ragStatus      RagStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?                @relation(fields: [caseId], references: [id])
  consultation Consultation?        @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  audioFile    File?                @relation(fields: [audioFileId], references: [id])
  chunks       TranscriptionChunk[]

  @@index([userId])
  @@index([organizationId])
  @@index([caseId])
  @@index([consultationId])
}

// Transcription chunk + embedding store (ADR 0013) — structurally identical to
// CaseDocumentChunk, but FK'd to Transcription instead of Document: a Transcription is a
// distinct, audio-derived kind of thing, not a Document, per this app's own glossary.
model TranscriptionChunk {
  id              String                       @id @default(uuid())
  transcriptionId String
  chunkIndex      Int
  chunkText       String
  charCount       Int
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())

  transcription Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@index([transcriptionId])
}

// Legal RAG tables (documents, document_chunks, ingestion_runs) live in this same
// database but are intentionally not modeled here — they're owned by an external
// ingestion pipeline. Query them via prisma.$queryRaw (see src/repositories/legal-rag.repository.ts)
// using DATABASE_URL.

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  cases          Case[]
  documents      Document[]
  consultations  Consultation[]
  bookmarks      Bookmark[]
  events         Event[]
  transcriptions Transcription[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String           @unique
  role           OrganizationRole @default(OWNER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
