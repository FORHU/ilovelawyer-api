model TerminalWorkspace {
  id         String          @id @default(uuid())
  userId     String
  // Nullable rather than backfilled — a workspace saved before case-scoping existed has no case
  // to attach to. Left null, it simply never matches a case-scoped list query, which is exactly
  // the desired "hidden going forward" behavior with no separate data migration.
  caseId     String?
  name       String
  preset     WorkspacePreset
  layoutJson Json
  isLastUsed Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caseId])
