model CitationCheck {
  id             String                 @id @default(uuid())
  caseId         String
  quotedText     String                 @db.Text
  citedReference String?
  sourceUrl      String?
  officialText   String?                @db.Text
  status         CitationValidityStatus @default(UNVERIFIED)
  notes          String?                @db.Text
  checkedAt      DateTime               @default(now())

  // Lazily resolved the first time this case's Citation Map is opened — matches citedReference's
  // free text against the Law corpus (see resolveCitationToLaw). Null until resolution is
  // attempted or when no confident match exists; resolutionConfidence is null in both cases too.
  resolvedLawId        String?
  resolutionConfidence Float?

  // Pinpoint reference (e.g. "para. 4" or "p. 15") — lawyer-entered, or auto-detected for UK
  // via a live search of the resolved judgment's actual text (see grepJudgment); never a guess.
  pinpoint String?

  // How quotedText relates to officialText — QUOTED needs no LLM call (a plain text match
  // already answers it, see citation-validity.ts's containsQuote); PARAPHRASED/INFERRED come
  // from a short classification call only when the quote isn't a clean match. Null when there's
  // no officialText to classify against at all.
  propositionType CitationPropositionType?

  case        Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  resolvedLaw Law? @relation("ResolvedLaw", fields: [resolvedLawId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([resolvedLawId])
}

