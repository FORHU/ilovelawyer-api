<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>Hello {{name}},</mj-text>
        <mj-text>Use the code below to verify your email and finish creating your ilovelawyer account.</mj-text>
        <mj-text align="center" font-size="32px" font-weight="bold" letter-spacing="8px">{{code}}</mj-text>
        <mj-text>This code will expire in 5 minutes. If you didn't request this, you can safely ignore this email.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
